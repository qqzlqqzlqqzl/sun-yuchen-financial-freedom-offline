      "timestamps": {
        "from": "00:04:33,772",
        "to": "00:04:35,812"
      },
      "offsets": {
        "from": 273772,
        "to": 275812
      },
      "text": "所规定的人权是人人"
    },
    {
      "timestamps": {
        "from": "00:04:35,812",
        "to": "00:04:38,372"
      },
      "offsets": {
        "from": 275812,
        "to": 278372
      },
      "text": "皆可享有的普世权利一样"
    },
    {
      "timestamps": {
        "from": "00:04:38,372",
        "to": "00:04:39,872"
      },
      "offsets": {
        "from": 278372,
        "to": 279872
      },
      "text": "财富自由"
    },
    {
      "timestamps": {
        "from": "00:04:39,872",
        "to": "00:04:42,312"
      },
      "offsets": {
        "from": 279872,
        "to": 282312
      },
      "text": "从不歧视任何人"
    },
    {
      "timestamps": {
        "from": "00:04:42,312",
        "to": "00:04:44,012"
      },
      "offsets": {
        "from": 282312,
        "to": 284012
      },
      "text": "只要你认同这一套"
    },
