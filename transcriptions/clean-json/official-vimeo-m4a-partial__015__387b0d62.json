        "from": 220332,
        "to": 222272
      },
      "text": "iOS系统进行升级"
    },
    {
      "timestamps": {
        "from": "00:03:42,272",
        "to": "00:03:43,872"
      },
      "offsets": {
        "from": 222272,
        "to": 223872
      },
      "text": "把我们的世界观进行升级"
    },
    {
      "timestamps": {
        "from": "00:03:43,872",
        "to": "00:03:45,872"
      },
      "offsets": {
        "from": 223872,
        "to": 225872
      },
      "text": "不断去迭代版本"
    },
    {
      "timestamps": {
        "from": "00:03:45,872",
        "to": "00:03:48,032"
      },
      "offsets": {
        "from": 225872,
        "to": 228032
      },
      "text": "真正决定财富自由"
    },
    {
      "timestamps": {
        "from": "00:03:48,032",
        "to": "00:03:50,472"
      },
      "offsets": {
        "from": 228032,
        "to": 230472
      },
      "text": "决定谁在残酷竞争中胜利了"
    },
    {
      "timestamps": {
        "from": "00:03:50,472",
        "to": "00:03:52,012"
      },
      "offsets": {
        "from": 230472,
        "to": 232012
      },
      "text": "是我们的价值观"
    },
    {
      "timestamps": {
        "from": "00:03:52,012",
        "to": "00:03:53,892"
      },
      "offsets": {
        "from": 232012,
        "to": 233892
      },
      "text": "是一场价值观的战争"
    },
    {
      "timestamps": {
        "from": "00:03:53,892",
        "to": "00:03:56,232"
      },
      "offsets": {
        "from": 233892,
        "to": 236232
      },
      "text": "所以我自己认为"
    },
    {
      "timestamps": {
        "from": "00:03:56,232",
        "to": "00:03:58,052"
      },
      "offsets": {
        "from": 236232,
        "to": 238052
      },
      "text": "财富自由的互联网价值观"
    },
    {
      "timestamps": {
        "from": "00:03:58,052",
        "to": "00:03:59,572"
      },
      "offsets": {
        "from": 238052,
        "to": 239572
      },
      "text": "是一种生活方式"
    },
    {
      "timestamps": {
        "from": "00:03:59,572",
        "to": "00:04:00,692"
      },
      "offsets": {
        "from": 239572,
        "to": 240692
      },
