    {
      "timestamps": {
        "from": "00:04:13,452",
        "to": "00:04:18,972"
      },
      "offsets": {
        "from": 253452,
        "to": 258972
      },
      "text": "财富自由体现于一整套观察信仰与改造世界"
    },
    {
      "timestamps": {
        "from": "00:04:18,972",
        "to": "00:04:22,972"
      },
      "offsets": {
        "from": 258972,
        "to": 262972
      },
      "text": "与家人相处与陌生人与熟人与亲情"
    },
    {
      "timestamps": {
        "from": "00:04:22,972",
        "to": "00:04:25,592"
      },
      "offsets": {
        "from": 262972,
        "to": 265592
      },
      "text": "友情爱情相处的方式"
    },
    {
      "timestamps": {
        "from": "00:04:25,592",
        "to": "00:04:28,832"
      },
      "offsets": {
        "from": 265592,
        "to": 268832
      },
