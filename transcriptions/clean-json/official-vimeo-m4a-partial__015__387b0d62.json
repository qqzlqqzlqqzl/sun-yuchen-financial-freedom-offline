      "timestamps": {
        "from": "00:04:03,972",
        "to": "00:04:05,472"
      },
      "offsets": {
        "from": 243972,
        "to": 245472
      },
      "text": "世界观与价值观"
    },
    {
      "timestamps": {
        "from": "00:04:05,472",
        "to": "00:04:08,912"
      },
      "offsets": {
        "from": 245472,
        "to": 248912
      },
      "text": "获取财富是对我们信仰的奖赏"
    },
    {
      "timestamps": {
        "from": "00:04:08,912",
        "to": "00:04:13,452"
      },
      "offsets": {
        "from": 248912,
        "to": 253452
      },
      "text": "而失去财富则是对他人或者我们不信仰的惩罚"
