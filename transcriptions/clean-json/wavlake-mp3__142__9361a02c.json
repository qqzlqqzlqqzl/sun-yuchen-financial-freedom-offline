      "timestamps": {
        "from": "00:02:55,659",
        "to": "00:02:56,879"
      },
      "offsets": {
        "from": 175659,
        "to": 176879
      },
      "text": "所以呢"
    },
    {
      "timestamps": {
        "from": "00:02:56,879",
        "to": "00:02:58,139"
      },
      "offsets": {
        "from": 176879,
        "to": 178139
      },
