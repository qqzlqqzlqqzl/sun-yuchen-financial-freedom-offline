      "timestamps": {
        "from": "00:02:30,779",
        "to": "00:02:32,619"
      },
      "offsets": {
        "from": 150779,
        "to": 152619
      },
      "text": "就每个人买我新书"
    },
    {
      "timestamps": {
        "from": "00:02:32,619",
        "to": "00:02:33,279"
      },
      "offsets": {
        "from": 152619,
        "to": 153279
      },
      "text": "这个token呢"
    },
