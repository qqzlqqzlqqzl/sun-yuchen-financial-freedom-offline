      "timestamps": {
        "from": "00:03:17,279",
        "to": "00:03:17,499"
      },
      "offsets": {
        "from": 197279,
        "to": 197499
      },
      "text": "是吧"
    },
    {
      "timestamps": {
        "from": "00:03:17,499",
        "to": "00:03:18,699"
      },
      "offsets": {
        "from": 197499,
        "to": 198699
      },
      "text": "我都已经卖光了"
    },
    {
      "timestamps": {
        "from": "00:03:18,699",
        "to": "00:03:19,279"
      },
      "offsets": {
        "from": 198699,
        "to": 199279
      },
      "text": "是吧"
    },
    {
      "timestamps": {
        "from": "00:03:19,279",
        "to": "00:03:21,059"
      },
      "offsets": {
        "from": 199279,
        "to": 201059
      },
