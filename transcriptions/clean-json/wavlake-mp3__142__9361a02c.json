      "timestamps": {
        "from": "00:04:39,908",
        "to": "00:04:40,208"
      },
      "offsets": {
        "from": 279908,
        "to": 280208
      },
      "text": "是吧"
    },
    {
      "timestamps": {
        "from": "00:04:40,208",
        "to": "00:04:42,348"
      },
      "offsets": {
        "from": 280208,
        "to": 282348
      },
