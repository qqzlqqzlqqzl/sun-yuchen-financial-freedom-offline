      "timestamps": {
        "from": "00:02:46,639",
        "to": "00:02:48,059"
      },
      "offsets": {
        "from": 166639,
        "to": 168059
      },
      "text": "如果我是出小说的话"
    },
    {
      "timestamps": {
        "from": "00:02:48,059",
        "to": "00:02:50,719"
      },
      "offsets": {
        "from": 168059,
        "to": 170719
      },
      "text": "甚至我可以按照这个买token"
    },
    {
      "timestamps": {
        "from": "00:02:50,719",
        "to": "00:02:52,339"
      },
      "offsets": {
        "from": 170719,
        "to": 172339
      },
      "text": "最多的人的喜好来创作"
    },
    {
      "timestamps": {
        "from": "00:02:52,339",
        "to": "00:02:54,139"
      },
      "offsets": {
        "from": 172339,
        "to": 174139
      },
      "text": "甚至你可以成为我的一个"
