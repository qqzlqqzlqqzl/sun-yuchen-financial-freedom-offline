    },
    {
      "timestamps": {
        "from": "00:04:45,448",
        "to": "00:04:46,108"
      },
      "offsets": {
        "from": 285448,
        "to": 286108
      },
      "text": "有很多人说"
    },
    {
      "timestamps": {
        "from": "00:04:46,108",
        "to": "00:04:48,348"
      },
      "offsets": {
        "from": 286108,
