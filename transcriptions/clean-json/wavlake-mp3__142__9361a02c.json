      "timestamps": {
        "from": "00:02:33,279",
        "to": "00:02:34,959"
      },
      "offsets": {
        "from": 153279,
        "to": 154959
      },
      "text": "都可以拥有我新书"
    },
    {
      "timestamps": {
        "from": "00:02:34,959",
        "to": "00:02:36,279"
      },
      "offsets": {
        "from": 154959,
        "to": 156279
      },
      "text": "我就会给他记一本"
