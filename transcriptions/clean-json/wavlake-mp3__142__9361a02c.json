      "timestamps": {
        "from": "00:04:23,808",
        "to": "00:04:24,348"
      },
      "offsets": {
        "from": 263808,
        "to": 264348
      },
      "text": "全球化"
    },
    {
      "timestamps": {
        "from": "00:04:24,348",
        "to": "00:04:26,528"
      },
      "offsets": {
        "from": 264348,
        "to": 266528
      },
