      "timestamps": {
        "from": "00:04:26,528",
        "to": "00:04:30,228"
      },
      "offsets": {
        "from": 266528,
        "to": 270228
      },
      "text": "所以我个人觉得这个是非常好的"
    },
    {
      "timestamps": {
        "from": "00:04:30,228",
        "to": "00:04:33,868"
      },
      "offsets": {
        "from": 270228,
        "to": 273868
      },
