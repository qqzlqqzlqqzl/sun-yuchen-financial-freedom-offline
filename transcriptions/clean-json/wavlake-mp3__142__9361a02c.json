    {
      "timestamps": {
        "from": "00:02:36,279",
        "to": "00:02:37,599"
      },
      "offsets": {
        "from": 156279,
        "to": 157599
      },
      "text": "同时呢"
    },
    {
      "timestamps": {
        "from": "00:02:37,599",
        "to": "00:02:39,159"
      },
      "offsets": {
        "from": 157599,
        "to": 159159
      },
      "text": "买我新书买的多的人"
