      "timestamps": {
        "from": "00:04:37,168",
        "to": "00:04:37,808"
      },
      "offsets": {
        "from": 277168,
        "to": 277808
      },
      "text": "对不对"
    },
    {
      "timestamps": {
        "from": "00:04:37,808",
        "to": "00:04:39,908"
      },
      "offsets": {
        "from": 277808,
        "to": 279908
      },
