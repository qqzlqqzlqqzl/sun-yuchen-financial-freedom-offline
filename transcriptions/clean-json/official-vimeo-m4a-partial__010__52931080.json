      },
      "text": "周边的影响"
    },
    {
      "timestamps": {
        "from": "00:03:23,463",
        "to": "00:03:26,203"
      },
      "offsets": {
        "from": 203463,
        "to": 206203
      },
      "text": "都希望我们去关心一些别的事情"
    },
    {
      "timestamps": {
        "from": "00:03:26,203",
        "to": "00:03:29,223"
      },
      "offsets": {
        "from": 206203,
        "to": 209223
      },
      "text": "比方说在我读书的时候"
    },
    {
      "timestamps": {
        "from": "00:03:29,223",
        "to": "00:03:31,783"
      },
      "offsets": {
        "from": 209223,
        "to": 211783
      },
      "text": "我父母甚至周边的老师"
    },
    {
      "timestamps": {
        "from": "00:03:31,783",
        "to": "00:03:34,743"
      },
      "offsets": {
        "from": 211783,
        "to": 214743
      },
      "text": "都希望我们能够去多关心国家大事"
    },
    {
      "timestamps": {
        "from": "00:03:34,743",
        "to": "00:03:36,323"
      },
      "offsets": {
        "from": 214743,
        "to": 216323
      },
      "text": "甚至关心中国的发展"
    },
    {
      "timestamps": {
        "from": "00:03:36,687",
        "to": "00:03:40,007"
      },
      "offsets": {
        "from": 216687,
        "to": 220007
      },
      "text": "长大之后我进入了北京大学"
    },
    {
      "timestamps": {
        "from": "00:03:40,007",
        "to": "00:03:44,187"
      },
      "offsets": {
        "from": 220007,
        "to": 224187
      },
      "text": "因为北大有非常强的关心国家时事的传统"
    },
    {
      "timestamps": {
        "from": "00:03:44,187",
        "to": "00:03:47,667"
      },
      "offsets": {
        "from": 224187,
        "to": 227667
      },
      "text": "同学们绝大多数都很关心国家的前途"
    },
    {
      "timestamps": {
        "from": "00:03:47,667",
        "to": "00:03:49,647"
      },
      "offsets": {
        "from": 227667,
        "to": 229647
      },
      "text": "我们经常开玩笑说"
    },
    {
      "timestamps": {
        "from": "00:03:49,647",
        "to": "00:03:52,007"
      },
      "offsets": {
        "from": 229647,
        "to": 232007
      },
      "text": "我们经常把酒问苍天"
    },
    {
      "timestamps": {
        "from": "00:03:52,007",
        "to": "00:03:55,407"
      },
      "offsets": {
        "from": 232007,
        "to": 235407
      },
      "text": "问问什么这个国家会好吗之类的"
    },
    {
      "timestamps": {
        "from": "00:03:55,407",
        "to": "00:03:58,447"
      },
      "offsets": {
        "from": 235407,
        "to": 238447
      },
      "text": "同时再打个比方"
    },
    {
      "timestamps": {
        "from": "00:03:58,447",
        "to": "00:04:00,827"
      },
      "offsets": {
        "from": 238447,
        "to": 240827
      },
      "text": "其实主要是男生了"
    },
    {
      "timestamps": {
        "from": "00:04:00,827",
        "to": "00:04:02,247"
      },
      "offsets": {
        "from": 240827,
        "to": 242247
      },
      "text": "其实我们经常逛论坛"
    },
    {
      "timestamps": {
        "from": "00:04:02,247",
        "to": "00:04:06,347"
      },
      "offsets": {
        "from": 242247,
        "to": 246347
      },
      "text": "去强国虎扑铁血论坛"
    },
    {
      "timestamps": {
        "from": "00:04:06,347",
        "to": "00:04:09,907"
      },
      "offsets": {
        "from": 246347,
        "to": 249907
      },
      "text": "也能经常发现一些关心国家大事"
    },
    {
      "timestamps": {
        "from": "00:04:09,907",
        "to": "00:04:11,167"
      },
      "offsets": {
        "from": 249907,
        "to": 251167
      },
      "text": "中美合作与冲突"
    },
    {
      "timestamps": {
        "from": "00:04:11,167",
        "to": "00:04:12,867"
      },
      "offsets": {
        "from": 251167,
        "to": 252867
      },
      "text": "中日必有一战之类的"
    },
    {
      "timestamps": {
        "from": "00:04:12,867",
        "to": "00:04:14,867"
      },
      "offsets": {
        "from": 252867,
        "to": 254867
      },
      "text": "对于这些年轻人来说"
    },
    {
      "timestamps": {
        "from": "00:04:14,867",
        "to": "00:04:16,307"
      },
      "offsets": {
        "from": 254867,
        "to": 256307
      },
      "text": "他们觉得不关心大事呢"
    },
    {
      "timestamps": {
        "from": "00:04:16,307",
        "to": "00:04:17,207"
      },
      "offsets": {
        "from": 256307,
        "to": 257207
      },
      "text": "就是没有灵魂"
    },
    {
      "timestamps": {
        "from": "00:04:17,207",
        "to": "00:04:18,847"
      },
      "offsets": {
        "from": 257207,
        "to": 258847
      },
      "text": "青春就是白白浪费了"
    },
    {
      "timestamps": {
        "from": "00:04:18,847",
        "to": "00:04:21,267"
      },
      "offsets": {
        "from": 258847,
        "to": 261267
      },
      "text": "我在网上曾经看到一个段子"
    },
    {
      "timestamps": {
        "from": "00:04:21,267",
        "to": "00:04:22,667"
      },
      "offsets": {
        "from": 261267,
        "to": 262667
      },
      "text": "我在这里引用一下"
    },
    {
      "timestamps": {
        "from": "00:04:22,667",
        "to": "00:04:26,187"
      },
      "offsets": {
        "from": 262667,
        "to": 266187
      },
      "text": "我自己觉得还是能蛮明显地说明这个问题的"
    },
    {
      "timestamps": {
        "from": "00:04:26,187",
        "to": "00:04:27,867"
      },
      "offsets": {
        "from": 266187,
        "to": 267867
      },
      "text": "现在段子开始了"
    },
    {
      "timestamps": {
        "from": "00:04:27,867",
        "to": "00:04:30,827"
      },
      "offsets": {
        "from": 267867,
        "to": 270827
      },
      "text": "在一个阴暗潮湿的地下室"
    },
    {
      "timestamps": {
        "from": "00:04:30,827",
        "to": "00:04:32,687"
      },
      "offsets": {
        "from": 270827,
        "to": 272687
      },
      "text": "一个瘦弱的青年"
    },
    {
      "timestamps": {
        "from": "00:04:32,687",
        "to": "00:04:35,967"
      },
      "offsets": {
        "from": 272687,
        "to": 275967
      },
      "text": "一手拿了三块五毛钱一包的椰树烟"
    },
    {
      "timestamps": {
        "from": "00:04:35,967",
        "to": "00:04:37,987"
      },
      "offsets": {
        "from": 275967,
        "to": 277987
      },
      "text": "一边看着铁血论坛"
    },
    {
      "timestamps": {
        "from": "00:04:37,987",
        "to": "00:04:40,827"
      },
      "offsets": {
        "from": 277987,
        "to": 280827
      },
      "text": "愁眉紧锁的他陷入了沉思"
    },
    {
      "timestamps": {
        "from": "00:04:40,827",
        "to": "00:04:43,727"
      },
      "offsets": {
        "from": 280827,
        "to": 283727
      },
      "text": "国家的下一步该怎么走"
    },
    {
      "timestamps": {
        "from": "00:04:43,727",
        "to": "00:04:46,147"
      },
      "offsets": {
        "from": 283727,
        "to": 286147
      },
      "text": "如何突破美国的封锁"
    },
    {
      "timestamps": {
        "from": "00:04:46,147",
        "to": "00:04:48,627"
      },
      "offsets": {
        "from": 286147,
        "to": 288627
      },
      "text": "如何保住南沙群岛"
    },
    {
      "timestamps": {
        "from": "00:04:48,627",
        "to": "00:04:51,507"
      },
      "offsets": {
        "from": 288627,
        "to": 291507
      },
      "text": "犯中华者虽远必诛"
    },
    {
      "timestamps": {
        "from": "00:04:51,797",
        "to": "00:04:54,437"
      },
      "offsets": {
        "from": 291797,
        "to": 294437
      },
      "text": "一个个难题需要他思索"
    },
    {
      "timestamps": {
        "from": "00:04:54,437",
        "to": "00:04:55,997"
      },
      "offsets": {
        "from": 294437,
        "to": 295997
      },
      "text": "需要他抉择"
    },
    {
      "timestamps": {
        "from": "00:04:55,997",
        "to": "00:05:00,297"
      },
      "offsets": {
        "from": 295997,
        "to": 300297
      },
      "text": "此时门外传来了咣咣的踹门声"
    },
    {
      "timestamps": {
        "from": "00:05:00,297",
        "to": "00:05:02,937"
      },
      "offsets": {
        "from": 300297,
        "to": 302937
      },
      "text": "开门该交房租了"
    },
    {
      "timestamps": {
        "from": "00:05:02,937",
        "to": "00:05:05,857"
      },
      "offsets": {
        "from": 302937,
        "to": 305857
      },
      "text": "也许很多人啊"
    },
    {
      "timestamps": {
        "from": "00:05:05,857",
        "to": "00:05:07,677"
      },
      "offsets": {
        "from": 305857,
        "to": 307677
      },
      "text": "其实在网上都看过这个段子"
    },
    {
      "timestamps": {
        "from": "00:05:07,677",
        "to": "00:05:08,897"
      },
      "offsets": {
        "from": 307677,
        "to": 308897
      },
      "text": "但这个段子呢"
    },
    {
      "timestamps": {
        "from": "00:05:08,897",
        "to": "00:05:11,857"
      },
      "offsets": {
        "from": 308897,
        "to": 311857
      },
      "text": "其实我觉得是可以很明显的反映出"
    },
    {
      "timestamps": {
        "from": "00:05:11,857",
        "to": "00:05:13,617"
      },
      "offsets": {
        "from": 311857,
        "to": 313617
      },
      "text": "并不关心财富自由"
    },
    {
      "timestamps": {
        "from": "00:05:13,617",
        "to": "00:05:17,117"
      },
      "offsets": {
        "from": 313617,
        "to": 317117
      },
      "text": "甚至并不关心合法赚钱人的生活了"
    },
    {
      "timestamps": {
        "from": "00:05:17,117",
        "to": "00:05:18,897"
      },
      "offsets": {
        "from": 317117,
        "to": 318897
      },
      "text": "其实我们可以看到"
    },
    {
      "timestamps": {
        "from": "00:05:18,897",
        "to": "00:05:20,277"
      },
      "offsets": {
        "from": 318897,
        "to": 320277
      },
      "text": "在生活中"
    },
    {
      "timestamps": {
        "from": "00:05:20,277",
        "to": "00:05:23,357"
      },
      "offsets": {
        "from": 320277,
        "to": 323357
      },
      "text": "我们最应该解决的是自己的问题"
    },
    {
      "timestamps": {
        "from": "00:05:23,357",
        "to": "00:05:25,877"
      },
      "offsets": {
        "from": 323357,
        "to": 325877
      },
      "text": "其实不光有关心大事的"
    },
    {
      "timestamps": {
        "from": "00:05:25,877",
        "to": "00:05:27,617"
      },
      "offsets": {
        "from": 325877,
        "to": 327617
      },
      "text": "也有关心小事的"
    },
    {
      "timestamps": {
        "from": "00:05:27,617",
        "to": "00:05:28,757"
      },
      "offsets": {
        "from": 327617,
        "to": 328757
      },
      "text": "比方说"
    },
    {
      "timestamps": {
        "from": "00:05:28,757",
        "to": "00:05:29,777"
      },
      "offsets": {
        "from": 328757,
        "to": 329777
      },
      "text": "掏粪男孩"
    },
    {
      "timestamps": {
        "from": "00:05:29,777",
        "to": "00:05:31,117"
      },
      "offsets": {
        "from": 329777,
        "to": 331117
      },
      "text": "鹿晗、吴亦凡"
    },
    {
      "timestamps": {
        "from": "00:05:31,117",
        "to": "00:05:33,137"
      },
      "offsets": {
        "from": 331117,
        "to": 333137
      },
      "text": "都有大量的迷妹和迷弟"
    },
    {
      "timestamps": {
        "from": "00:05:33,137",
        "to": "00:05:36,317"
      },
      "offsets": {
        "from": 333137,
        "to": 336317
      },
      "text": "甚至在我自己非常小的时候"
    },
    {
      "timestamps": {
        "from": "00:05:36,317",
        "to": "00:05:37,477"
      },
      "offsets": {
        "from": 336317,
        "to": 337477
      },
      "text": "初高中的时候"
    },
    {
      "timestamps": {
        "from": "00:05:37,477",
        "to": "00:05:38,517"
      },
      "offsets": {
        "from": 337477,
        "to": 338517
      },
      "text": "我也当过脑残粉"
    },
    {
      "timestamps": {
        "from": "00:05:38,517",
        "to": "00:05:41,957"
      },
      "offsets": {
        "from": 338517,
        "to": 341957
      },
      "text": "我们也经常觉得要把很多时间花在追星上"
    },
    {
      "timestamps": {
        "from": "00:05:41,957",
        "to": "00:05:43,897"
      },
      "offsets": {
        "from": 341957,
        "to": 343897
      },
      "text": "包括我自己的妹妹"
    },
    {
      "timestamps": {
        "from": "00:05:43,897",
        "to": "00:05:45,817"
      },
      "offsets": {
        "from": 343897,
        "to": 345817
      },
      "text": "家里就贴满了掏粪男孩的海报"
    },
    {
      "timestamps": {
        "from": "00:05:45,817",
        "to": "00:05:48,397"
      },
      "offsets": {
        "from": 345817,
        "to": 348397
      },
      "text": "甚至有的人不关心明星"
    },
    {
      "timestamps": {
        "from": "00:05:48,397",
        "to": "00:05:50,657"
      },
      "offsets": {
        "from": 348397,
        "to": 350657
      },
      "text": "但是会关心别人的家长里短"
    },
    {
      "timestamps": {
        "from": "00:05:50,657",
        "to": "00:05:52,817"
      },
      "offsets": {
        "from": 350657,
        "to": 352817
      },
      "text": "天天像狗仔队一样"
    },
    {
      "timestamps": {
        "from": "00:05:52,817",
        "to": "00:05:53,917"
      },
      "offsets": {
        "from": 352817,
        "to": 353917
      },
      "text": "关心周边人的八卦"
    },
    {
      "timestamps": {
        "from": "00:05:53,917",
        "to": "00:05:55,237"
      },
      "offsets": {
        "from": 353917,
        "to": 355237
      },
      "text": "皇帝不急太监急"
    },
    {
      "timestamps": {
        "from": "00:05:55,237",
        "to": "00:05:56,557"
      },
      "offsets": {
        "from": 355237,
        "to": 356557
      },
      "text": "比所有人都急"
    },
    {
      "timestamps": {
        "from": "00:05:56,557",
        "to": "00:05:58,977"
      },
      "offsets": {
        "from": 356557,
        "to": 358977
      },
      "text": "其实所有的这些事情"
    },
    {
      "timestamps": {
        "from": "00:05:58,977",
        "to": "00:06:00,837"
      },
      "offsets": {
        "from": 358977,
        "to": 360837
      },
      "text": "我们讲极端点"
    },
    {
      "timestamps": {
        "from": "00:06:00,837",
        "to": "00:06:04,957"
      },
      "offsets": {
        "from": 360837,
        "to": 364957
      },
      "text": "都可以用干我屁事和干你屁事来解决"
    },
    {
      "timestamps": {
        "from": "00:06:04,957",
        "to": "00:06:07,877"
      },
      "offsets": {
        "from": 364957,
        "to": 367877
      },
      "text": "财富自由才是我们关心的正经事"
    },
    {
      "timestamps": {
        "from": "00:06:07,877",
        "to": "00:06:09,857"
      },
      "offsets": {
        "from": 367877,
        "to": 369857
      },
      "text": "我们甚至可以说"
    },
    {
      "timestamps": {
        "from": "00:06:09,353",
        "to": "00:06:11,293"
      },
      "offsets": {
        "from": 369353,
        "to": 371293
      },
      "text": "财富自由与独立"
    },
    {
      "timestamps": {
        "from": "00:06:11,293",
        "to": "00:06:14,393"
      },
      "offsets": {
        "from": 371293,
        "to": 374393
      },
      "text": "会给个人带来精神的自由与解放"
    },
    {
      "timestamps": {
        "from": "00:06:14,393",
        "to": "00:06:17,173"
      },
      "offsets": {
        "from": 374393,
        "to": 377173
      },
      "text": "给社会带来积极的进步与变化"
    },
    {
      "timestamps": {
        "from": "00:06:17,173",
        "to": "00:06:19,433"
      },
      "offsets": {
        "from": 377173,
        "to": 379433
      },
      "text": "会给国家带来无数个"
    },
    {
      "timestamps": {
        "from": "00:06:19,433",
        "to": "00:06:21,813"
      },
      "offsets": {
        "from": 379433,
        "to": 381813
      },
      "text": "有钱有趣有理想的新公民"
    },
    {
      "timestamps": {
        "from": "00:06:21,813",
        "to": "00:06:24,613"
      },
      "offsets": {
        "from": 381813,
        "to": 384613
      },
      "text": "当然财富自由本身就是目的"
    },
    {
      "timestamps": {
        "from": "00:06:24,613",
        "to": "00:06:25,593"
      },
      "offsets": {
        "from": 384613,
        "to": 385593
      },
      "text": "不是手段"
    },
    {
      "timestamps": {
        "from": "00:06:25,593",
        "to": "00:06:29,133"
      },
      "offsets": {
        "from": 385593,
        "to": 389133
      },
      "text": "财富自由光听一听就很美好了"
    },
    {
      "timestamps": {
        "from": "00:06:29,133",
        "to": "00:06:30,293"
      },
      "offsets": {
        "from": 389133,
        "to": 390293
      },
      "text": "不是吗"
    },
    {
      "timestamps": {
        "from": "00:06:30,293",
        "to": "00:06:33,853"
      },
      "offsets": {
        "from": 390293,
        "to": 393853
      },
      "text": "让我们一起树立赚钱在中国的合法性吧"
    },
    {
      "timestamps": {
        "from": "00:06:33,853",
        "to": "00:06:35,533"
      },
      "offsets": {
        "from": 393853,
        "to": 395533
      },
      "text": "多一个赚钱的人"
    },
    {
      "timestamps": {
        "from": "00:06:35,533",
        "to": "00:06:37,233"
      },
      "offsets": {
        "from": 395533,
        "to": 397233
      },
      "text": "国家就多一份希望"
    },
    {
      "timestamps": {
        "from": "00:06:37,233",
        "to": "00:06:39,173"
      },
      "offsets": {
        "from": 397233,
        "to": 399173
      },
      "text": "我希望到这里"
    },
    {
      "timestamps": {
        "from": "00:06:39,173",
        "to": "00:06:42,513"
      },
      "offsets": {
        "from": 399173,
        "to": 402513
      },
      "text": "你多了一个订阅财富自由专栏的理由"
    },
    {
      "timestamps": {
        "from": "00:06:42,513",
        "to": "00:06:44,273"
      },
      "offsets": {
        "from": 402513,
        "to": 404273
      },
      "text": "欢迎订阅"
    },
    {
      "timestamps": {
        "from": "00:06:44,273",
        "to": "00:06:47,393"
      },
      "offsets": {
        "from": 404273,
        "to": 407393
      },
      "text": "我在财富自由的那一端等着你"
    },
    {
      "timestamps": {
        "from": "00:06:47,393",
        "to": "00:06:48,873"
      },
      "offsets": {
        "from": 407393,
        "to": 408873
      },
      "text": "欢迎到喜马拉雅"
    },
    {
      "timestamps": {
        "from": "00:06:48,873",
        "to": "00:06:51,453"
      },
      "offsets": {
        "from": 408873,
        "to": 411453
      },
      "text": "我的同名微博孙宇晨评论处留言"
    },
    {
      "timestamps": {
        "from": "00:06:51,453",
        "to": "00:06:53,733"
      },
      "offsets": {
        "from": 411453,
        "to": 413733
      },
      "text": "参加的所有优秀留言"
    },
    {
      "timestamps": {
        "from": "00:06:53,733",
        "to": "00:06:57,233"
      },
      "offsets": {
        "from": 413733,
        "to": 417233
      },
      "text": "都有机会获得每周抽奖的神秘礼物"
    },
    {
      "timestamps": {
        "from": "00:06:57,233",
        "to": "00:06:59,513"
      },
      "offsets": {
        "from": 417233,
        "to": 419513
      },
      "text": "如果你去我的微博看一下"
    },
    {
      "timestamps": {
        "from": "00:06:59,513",
        "to": "00:07:03,153"
      },
      "offsets": {
        "from": 419513,
        "to": 423153
      },
      "text": "我们最近正在抽的置顶微博是抽一台iPhone7"
    },
    {
      "timestamps": {
        "from": "00:07:03,153",
        "to": "00:07:06,273"
      },
      "offsets": {
        "from": 423153,
        "to": 426273
      },
      "text": "所以好好参加抽奖提问"
    },
    {
      "timestamps": {
        "from": "00:07:06,273",
        "to": "00:07:07,773"
      },
      "offsets": {
        "from": 426273,
        "to": 427773
      },
      "text": "还是有不错的礼物的"
    },
    {
      "timestamps": {
        "from": "00:07:07,773",
        "to": "00:07:09,373"
      },
      "offsets": {
        "from": 427773,
        "to": 429373
      },
      "text": "本期的问题"
    },
    {
      "timestamps": {
        "from": "00:07:09,373",
        "to": "00:07:13,513"
      },
      "offsets": {
        "from": 429373,
        "to": 433513
      },
      "text": "你同意年轻人首先应当关心合法赚钱吗"
    },
    {
      "timestamps": {
        "from": "00:07:13,513",
        "to": "00:07:14,313"
      },
      "offsets": {
        "from": 433513,
        "to": 434313
      },
      "text": "为什么"
    },
    {
      "timestamps": {
        "from": "00:07:14,313",
        "to": "00:07:15,673"
      },
      "offsets": {
        "from": 434313,
        "to": 435673
      },
      "text": "如果有了答案"
    },
    {
      "timestamps": {
        "from": "00:07:15,673",
        "to": "00:07:17,173"
      },
      "offsets": {
        "from": 435673,
        "to": 437173
      },
      "text": "请到我的新浪微博"
    },
    {
      "timestamps": {
        "from": "00:07:17,173",
        "to": "00:07:19,773"
      },
      "offsets": {
        "from": 437173,
        "to": 439773
      },
      "text": "以及喜马拉雅的留言处给我留言"
    },
    {
      "timestamps": {
        "from": "00:07:19,773",
        "to": "00:07:21,033"
      },
      "offsets": {
        "from": 439773,
        "to": 441033
      },
      "text": "谢谢"
    }
  ]
}
