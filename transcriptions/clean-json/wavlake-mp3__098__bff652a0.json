    },
    {
      "timestamps": {
        "from": "00:04:37,856",
        "to": "00:04:39,236"
      },
      "offsets": {
        "from": 277856,
        "to": 279236
      },
      "text": "跟我不是学习成功"
    },
    {
      "timestamps": {
        "from": "00:04:39,236",
        "to": "00:04:40,836"
      },
      "offsets": {
        "from": 279236,
        "to": 280836
      },
      "text": "就是来学习失败"
    },
    {
      "timestamps": {
        "from": "00:04:40,836",
        "to": "00:04:47,996"
      },
      "offsets": {
        "from": 280836,
        "to": 287996
      },
      "text": "而且我认为一个企业的成长经验与行业是无关的"
    },
    {
      "timestamps": {
        "from": "00:04:47,996",
        "to": "00:04:51,536"
      },
      "offsets": {
        "from": 287996,
        "to": 291536
      },
      "text": "无论是一家传统消费品盈利的白酒企业"
    },
    {
      "timestamps": {
        "from": "00:04:51,536",
        "to": "00:04:52,776"
      },
      "offsets": {
        "from": 291536,
        "to": 292776
      },
      "text": "像我这样的秦驰"
    },
    {
      "timestamps": {
        "from": "00:04:52,776",
        "to": "00:04:53,336"
      },
      "offsets": {
        "from": 292776,
        "to": 293336
      },
      "text": "是吧"
    },
    {
      "timestamps": {
        "from": "00:04:53,336",
        "to": "00:04:54,256"
      },
      "offsets": {
        "from": 293336,
        "to": 294256
      },
      "text": "这样的"
    },
    {
      "timestamps": {
        "from": "00:04:53,749",
        "to": "00:04:56,649"
      },
      "offsets": {
        "from": 293749,
        "to": 296649
      },
      "text": "包括这些就是吴小波这本书里面"
    },
    {
      "timestamps": {
        "from": "00:04:56,649",
        "to": "00:04:58,309"
      },
      "offsets": {
        "from": 296649,
        "to": 298309
      },
      "text": "绝大多数都是这种传统企业"
    },
    {
      "timestamps": {
        "from": "00:04:58,309",
        "to": "00:05:00,389"
      },
      "offsets": {
        "from": 298309,
        "to": 300389
      },
      "text": "还是靠依靠大量用户"
    },
    {
      "timestamps": {
        "from": "00:05:00,389",
        "to": "00:05:02,709"
      },
      "offsets": {
        "from": 300389,
        "to": 302709
      },
      "text": "获得风险投资的移动互联网企业"
    },
    {
      "timestamps": {
        "from": "00:05:02,709",
        "to": "00:05:05,529"
      },
      "offsets": {
        "from": 302709,
        "to": 305529
      },
      "text": "在成长中面临的商业规律"
    },
    {
      "timestamps": {
        "from": "00:05:05,529",
        "to": "00:05:09,769"
      },
      "offsets": {
        "from": 305529,
        "to": 309769
      },
      "text": "商业真理往往具有共性和一致性"
    },
    {
      "timestamps": {
        "from": "00:05:09,769",
        "to": "00:05:13,389"
      },
      "offsets": {
        "from": 309769,
        "to": 313389
      },
      "text": "大败局这本书里面的案例"
    },
    {
      "timestamps": {
        "from": "00:05:13,389",
        "to": "00:05:15,889"
      },
      "offsets": {
        "from": 313389,
        "to": 315889
      },
      "text": "都是前人的血泪经验"
    },
    {
      "timestamps": {
        "from": "00:05:15,889",
        "to": "00:05:19,809"
      },
      "offsets": {
        "from": 315889,
        "to": 319809
      },
      "text": "是前人用几百亿的轰然倒塌"
    },
    {
      "timestamps": {
        "from": "00:05:19,809",
        "to": "00:05:21,329"
      },
      "offsets": {
        "from": 319809,
        "to": 321329
      },
      "text": "证明的此度不同"
    },
    {
      "timestamps": {
        "from": "00:05:21,329",
        "to": "00:05:23,429"
      },
      "offsets": {
        "from": 321329,
        "to": 323429
      },
      "text": "我个人觉得"
    },
    {
      "timestamps": {
        "from": "00:05:23,429",
        "to": "00:05:25,889"
      },
      "offsets": {
        "from": 323429,
        "to": 325889
      },
      "text": "值得每一个创业者"
    },
    {
      "timestamps": {
        "from": "00:05:25,889",
        "to": "00:05:28,069"
      },
      "offsets": {
        "from": 325889,
        "to": 328069
      },
      "text": "在夜深人静时"
    },
    {
      "timestamps": {
        "from": "00:05:28,069",
        "to": "00:05:29,769"
      },
      "offsets": {
        "from": 328069,
        "to": 329769
      },
      "text": "独自思索"
    },
    {
      "timestamps": {
        "from": "00:05:29,769",
        "to": "00:05:31,249"
      },
      "offsets": {
        "from": 329769,
        "to": 331249
      },
      "text": "独自体会"
    },
    {
      "timestamps": {
        "from": "00:05:31,249",
        "to": "00:05:35,309"
      },
      "offsets": {
        "from": 331249,
        "to": 335309
      },
      "text": "再讲讲我和这本书"
    },
    {
      "timestamps": {
        "from": "00:05:35,309",
        "to": "00:05:36,709"
      },
      "offsets": {
        "from": 335309,
        "to": 336709
      },
      "text": "有什么样的故事"
    },
    {
      "timestamps": {
        "from": "00:05:36,709",
        "to": "00:05:39,669"
      },
      "offsets": {
        "from": 336709,
        "to": 339669
      },
      "text": "其实大外局这本书"
    },
    {
      "timestamps": {
        "from": "00:05:39,669",
        "to": "00:05:42,729"
      },
      "offsets": {
        "from": 339669,
        "to": 342729
      },
      "text": "我自己是在2012年读的"
    },
    {
      "timestamps": {
        "from": "00:05:42,729",
        "to": "00:05:44,729"
      },
      "offsets": {
        "from": 342729,
        "to": 344729
      },
      "text": "当时我自己"
    },
    {
      "timestamps": {
        "from": "00:05:44,729",
        "to": "00:05:47,089"
      },
      "offsets": {
        "from": 344729,
        "to": 347089
      },
      "text": "还在做一个深刻的思索"
    },
    {
      "timestamps": {
        "from": "00:05:47,089",
        "to": "00:05:48,869"
      },
      "offsets": {
        "from": 347089,
        "to": 348869
      },
      "text": "就是到底要不要"
    },
    {
      "timestamps": {
        "from": "00:05:48,869",
        "to": "00:05:50,689"
      },
      "offsets": {
        "from": 348869,
        "to": 350689
      },
      "text": "踏上创业这条道路"
    },
    {
      "timestamps": {
        "from": "00:05:50,689",
        "to": "00:05:51,509"
      },
      "offsets": {
        "from": 350689,
        "to": 351509
      },
      "text": "五年前"
    },
    {
      "timestamps": {
        "from": "00:05:51,509",
        "to": "00:05:54,869"
      },
      "offsets": {
        "from": 351509,
        "to": 354869
      },
      "text": "现在已经是2017年了"
    },
    {
      "timestamps": {
        "from": "00:05:54,869",
        "to": "00:05:57,309"
      },
      "offsets": {
        "from": 354869,
        "to": 357309
      },
      "text": "当然大家最终也知道结局了"
    },
    {
      "timestamps": {
        "from": "00:05:57,309",
        "to": "00:05:59,489"
      },
      "offsets": {
        "from": 357309,
        "to": 359489
      },
      "text": "就是我当时最后决定创业了"
    },
    {
      "timestamps": {
        "from": "00:05:59,489",
        "to": "00:06:02,629"
      },
      "offsets": {
        "from": 359489,
        "to": 362629
      },
      "text": "这现在也是我创业的第五年"
    },
    {
      "timestamps": {
        "from": "00:06:02,629",
        "to": "00:06:05,309"
      },
      "offsets": {
        "from": 362629,
        "to": 365309
      },
      "text": "我也用我自己的经历"
    },
    {
      "timestamps": {
        "from": "00:06:05,309",
        "to": "00:06:07,429"
      },
      "offsets": {
        "from": 365309,
        "to": 367429
      },
      "text": "为大败局这本书"
    },
    {
      "timestamps": {
        "from": "00:06:07,429",
        "to": "00:06:09,689"
      },
      "offsets": {
        "from": 367429,
        "to": 369689
      },
      "text": "交上了一份属于我自己的答卷"
    },
    {
      "timestamps": {
        "from": "00:06:09,689",
        "to": "00:06:13,069"
      },
      "offsets": {
        "from": 369689,
        "to": 373069
      },
      "text": "交上了我自己的一个五年的创业史"
    },
    {
      "timestamps": {
        "from": "00:06:14,018",
        "to": "00:06:16,698"
      },
      "offsets": {
        "from": 374018,
        "to": 376698
      },
      "text": "我也将自己的这个创业故事与经历"
    },
    {
      "timestamps": {
        "from": "00:06:16,698",
        "to": "00:06:19,858"
      },
      "offsets": {
        "from": 376698,
        "to": 379858
      },
      "text": "包括之前的求学经历一共加起来十年"
    },
    {
      "timestamps": {
        "from": "00:06:19,858",
        "to": "00:06:22,578"
      },
      "offsets": {
        "from": 379858,
        "to": 382578
      },
      "text": "从2007年到2017年"
    },
    {
      "timestamps": {
        "from": "00:06:22,578",
        "to": "00:06:24,578"
      },
      "offsets": {
        "from": 382578,
        "to": 384578
      },
      "text": "写成了一本新书"
    },
    {
      "timestamps": {
        "from": "00:06:24,578",
        "to": "00:06:28,918"
      },
      "offsets": {
        "from": 384578,
        "to": 388918
      },
      "text": "叫《这世界既残酷也温柔》"
    },
    {
      "timestamps": {
        "from": "00:06:28,918",
        "to": "00:06:30,998"
      },
      "offsets": {
        "from": 388918,
        "to": 390998
      },
      "text": "我想啊"
    },
    {
      "timestamps": {
        "from": "00:06:30,998",
        "to": "00:06:32,918"
      },
      "offsets": {
        "from": 390998,
        "to": 392918
      },
      "text": "如果今天听到这个节目的读者"
    },
    {
      "timestamps": {
        "from": "00:06:32,918",
        "to": "00:06:34,418"
      },
      "offsets": {
        "from": 392918,
        "to": 394418
      },
      "text": "如果有时间"
    },
    {
      "timestamps": {
        "from": "00:06:34,418",
        "to": "00:06:37,758"
      },
      "offsets": {
        "from": 394418,
        "to": 397758
      },
      "text": "真的可以将《大败局》这本书"
    },
    {
      "timestamps": {
        "from": "00:06:37,758",
        "to": "00:06:41,338"
      },
      "offsets": {
        "from": 397758,
        "to": 401338
      },
      "text": "与我的新书对比拿来看一看"
    },
    {
      "timestamps": {
        "from": "00:06:41,338",
        "to": "00:06:43,258"
      },
      "offsets": {
        "from": 401338,
        "to": 403258
      },
      "text": "当然也可以在网上查一查我自己的经历"
    },
    {
      "timestamps": {
        "from": "00:06:43,258",
        "to": "00:06:45,118"
      },
      "offsets": {
        "from": 403258,
        "to": 405118
      },
      "text": "包括我自己的新书里面"
    },
    {
      "timestamps": {
        "from": "00:06:45,118",
        "to": "00:06:47,438"
      },
      "offsets": {
        "from": 405118,
        "to": 407438
      },
      "text": "刹脑的90后不买房"
    },
    {
      "timestamps": {
        "from": "00:06:47,438",
        "to": "00:06:48,818"
      },
      "offsets": {
        "from": 407438,
        "to": 408818
      },
      "text": "不结婚"
    },
    {
      "timestamps": {
        "from": "00:06:48,818",
        "to": "00:06:50,898"
      },
      "offsets": {
        "from": 408818,
        "to": 410898
      },
      "text": "不买车的这个三不主义"
    },
    {
      "timestamps": {
        "from": "00:06:50,898",
        "to": "00:06:55,198"
      },
      "offsets": {
        "from": 410898,
        "to": 415198
      },
      "text": "我相信大家也会发现很多新的东西"
    },
    {
      "timestamps": {
        "from": "00:06:55,198",
        "to": "00:06:58,278"
      },
      "offsets": {
        "from": 415198,
        "to": 418278
      },
      "text": "可以看出90后这一代创业者"
    },
    {
      "timestamps": {
        "from": "00:06:58,278",
        "to": "00:07:02,638"
      },
      "offsets": {
        "from": 418278,
        "to": 422638
      },
      "text": "与大败局里面写的50后60后那一代创业者"
    },
    {
      "timestamps": {
        "from": "00:07:02,638",
        "to": "00:07:04,418"
      },
      "offsets": {
        "from": 422638,
        "to": 424418
      },
      "text": "有哪些相同"
    },
    {
      "timestamps": {
        "from": "00:07:04,418",
        "to": "00:07:05,978"
      },
      "offsets": {
        "from": 424418,
        "to": 425978
      },
      "text": "哪些不同"
    },
    {
      "timestamps": {
        "from": "00:07:05,978",
        "to": "00:07:09,838"
      },
      "offsets": {
        "from": 425978,
        "to": 429838
      },
      "text": "每一代创业者"
    },
    {
      "timestamps": {
        "from": "00:07:09,838",
        "to": "00:07:12,378"
      },
      "offsets": {
        "from": 429838,
        "to": 432378
      },
      "text": "都有自己的宿命与使命"
    },
    {
      "timestamps": {
        "from": "00:07:12,378",
        "to": "00:07:15,898"
      },
      "offsets": {
        "from": 432378,
        "to": 435898
      },
      "text": "也正是在大败局这本书里面"
    },
    {
      "timestamps": {
        "from": "00:07:15,898",
        "to": "00:07:19,098"
      },
      "offsets": {
        "from": 435898,
        "to": 439098
      },
      "text": "我目睹了那些五零后六零后的创业者"
    },
    {
      "timestamps": {
        "from": "00:07:19,098",
        "to": "00:07:21,698"
      },
      "offsets": {
        "from": 439098,
        "to": 441698
      },
      "text": "白手起家从身无分文"
    },
    {
      "timestamps": {
        "from": "00:07:21,698",
        "to": "00:07:25,538"
      },
      "offsets": {
        "from": 441698,
        "to": 445538
      },
      "text": "到创造中国经济增长神的奇迹"
    },
    {
      "timestamps": {
        "from": "00:07:25,538",
        "to": "00:07:29,238"
      },
      "offsets": {
        "from": 445538,
        "to": 449238
      },
      "text": "激励我最终走向了创业道路"
    },
    {
      "timestamps": {
        "from": "00:07:29,127",
        "to": "00:07:33,707"
      },
      "offsets": {
        "from": 449127,
        "to": 453707
      },
      "text": "我相信即便他们"
    },
    {
      "timestamps": {
        "from": "00:07:33,707",
        "to": "00:07:35,827"
      },
      "offsets": {
        "from": 453707,
        "to": 455827
      },
      "text": "因为刚才我讲的这些企业"
    },
    {
      "timestamps": {
        "from": "00:07:35,827",
        "to": "00:07:37,147"
      },
      "offsets": {
        "from": 455827,
        "to": 457147
      },
      "text": "无论什么科隆"
    },
    {
      "timestamps": {
        "from": "00:07:37,147",
        "to": "00:07:38,967"
      },
      "offsets": {
        "from": 457147,
        "to": 458967
      },
      "text": "这个玫瑰园"
    },
    {
      "timestamps": {
        "from": "00:07:38,967",
        "to": "00:07:40,467"
      },
      "offsets": {
        "from": 458967,
        "to": 460467
      },
      "text": "这些太阳神"
    },
    {
      "timestamps": {
        "from": "00:07:40,467",
        "to": "00:07:41,087"
      },
      "offsets": {
        "from": 460467,
        "to": 461087
      },
      "text": "三猪"
    },
    {
      "timestamps": {
        "from": "00:07:41,087",
        "to": "00:07:41,947"
      },
      "offsets": {
        "from": 461087,
        "to": 461947
      },
      "text": "秦驰"
    },
    {
      "timestamps": {
        "from": "00:07:41,947",
        "to": "00:07:43,427"
      },
      "offsets": {
        "from": 461947,
        "to": 463427
      },
      "text": "巨人"
    },
    {
      "timestamps": {
        "from": "00:07:43,427",
        "to": "00:07:46,687"
      },
      "offsets": {
        "from": 463427,
        "to": 466687
      },
      "text": "即便他们如下花般灿烂"
    },
    {
      "timestamps": {
        "from": "00:07:46,687",
        "to": "00:07:51,507"
      },
      "offsets": {
        "from": 466687,
        "to": 471507
      },
      "text": "最终都在时间长河的冲刷下"
    },
    {
      "timestamps": {
        "from": "00:07:51,507",
        "to": "00:07:54,447"
      },
      "offsets": {
        "from": 471507,
        "to": 474447
      },
      "text": "最终归于了孤独与沉寂"
    },
    {
      "timestamps": {
        "from": "00:07:54,447",
        "to": "00:07:57,127"
      },
      "offsets": {
        "from": 474447,
        "to": 477127
      },
      "text": "但是他们毕竟辉煌过"
    },
    {
      "timestamps": {
        "from": "00:07:57,127",
        "to": "00:07:59,367"
      },
      "offsets": {
        "from": 477127,
        "to": 479367
      },
      "text": "毕竟为时代为国家"
    },
    {
      "timestamps": {
        "from": "00:07:59,367",
        "to": "00:08:02,447"
      },
      "offsets": {
        "from": 479367,
        "to": 482447
      },
      "text": "承担了在那一个时间段"
    },
    {
      "timestamps": {
