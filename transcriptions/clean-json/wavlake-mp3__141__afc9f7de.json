      "timestamps": {
        "from": "00:03:28,753",
        "to": "00:03:31,353"
      },
      "offsets": {
        "from": 208753,
        "to": 211353
      },
      "text": "同时在币圈中也是赚足了眼球吧"
    },
    {
      "timestamps": {
        "from": "00:03:31,353",
        "to": "00:03:32,993"
      },
      "offsets": {
        "from": 211353,
        "to": 212993
      },
      "text": "很多人都关注咱们这个项目"
    },
    {
      "timestamps": {
        "from": "00:03:32,993",
        "to": "00:03:35,873"
      },
      "offsets": {
        "from": 212993,
        "to": 215873
      },
      "text": "其实咱们这个项目的初心呢"
    },
    {
      "timestamps": {
        "from": "00:03:35,873",
        "to": "00:03:44,153"
      },
      "offsets": {
        "from": 215873,
        "to": 224153
      },
      "text": "核心就是想做一个未来能够赋能内容创业者的数字资产发行平台"
    },
    {
      "timestamps": {
        "from": "00:03:43,662",
        "to": "00:03:46,302"
      },
      "offsets": {
        "from": 223662,
        "to": 226302
      },
      "text": "也就是说我经常举的一个例子"
    },
    {
      "timestamps": {
        "from": "00:03:46,302",
        "to": "00:03:46,942"
      },
      "offsets": {
        "from": 226302,
        "to": 226942
      },
      "text": "就是未来"
    },
    {
      "timestamps": {
        "from": "00:03:46,942",
        "to": "00:03:50,622"
      },
      "offsets": {
        "from": 226942,
        "to": 230622
      },
      "text": "吴京不用通过卖房才能拍战狼2"
    },
    {
      "timestamps": {
        "from": "00:03:50,622",
        "to": "00:03:54,082"
      },
      "offsets": {
        "from": 230622,
        "to": 234082
      },
      "text": "而可以通过向吴京的社群"
    },
    {
      "timestamps": {
        "from": "00:03:54,082",
        "to": "00:03:57,622"
      },
      "offsets": {
        "from": 234082,
        "to": 237622
      },
      "text": "进行数字资产发行与登记的模式"
    },
    {
      "timestamps": {
        "from": "00:03:57,622",
        "to": "00:03:59,282"
      },
      "offsets": {
        "from": 237622,
        "to": 239282
      },
      "text": "来拍摄战狼2"
    },
    {
      "timestamps": {
        "from": "00:03:59,282",
        "to": "00:04:06,022"
      },
      "offsets": {
        "from": 239282,
        "to": 246022
      },
      "text": "当然参与战狼2数字资产发行募集的粉丝们"
    },
    {
      "timestamps": {
        "from": "00:04:06,022",
        "to": "00:04:10,522"
      },
      "offsets": {
        "from": 246022,
        "to": 250522
      },
      "text": "也可以获得吴京拍摄战狼2所带来的增值"
    },
    {
      "timestamps": {
        "from": "00:04:10,522",
        "to": "00:04:13,742"
      },
      "offsets": {
        "from": 250522,
        "to": 253742
      },
      "text": "当然如果没有增值"
    },
    {
      "timestamps": {
        "from": "00:04:13,742",
        "to": "00:04:17,042"
      },
      "offsets": {
        "from": 253742,
        "to": 257042
      },
      "text": "你就可以当做是为自己爱好的一种买单"
    },
    {
      "timestamps": {
        "from": "00:04:17,042",
        "to": "00:04:19,742"
      },
      "offsets": {
        "from": 257042,
        "to": 259742
      },
      "text": "就像我自己非常喜欢权力的游戏"
    },
    {
      "timestamps": {
        "from": "00:04:19,742",
        "to": "00:04:22,982"
      },
      "offsets": {
        "from": 259742,
        "to": 262982
      },
      "text": "这部美剧就冰与火之歌改编的"
    },
    {
      "timestamps": {
        "from": "00:04:22,982",
        "to": "00:04:26,582"
      },
      "offsets": {
        "from": 262982,
        "to": 266582
      },
      "text": "日后其实如果有冰与火之歌外传的改编"
    },
    {
      "timestamps": {
        "from": "00:04:26,582",
        "to": "00:04:30,322"
      },
      "offsets": {
        "from": 266582,
        "to": 270322
      },
      "text": "我甚至就是在制片方没有投钱之前"
    },
    {
      "timestamps": {
        "from": "00:04:30,322",
        "to": "00:04:32,122"
      },
      "offsets": {
        "from": 270322,
        "to": 272122
      },
      "text": "我自己都愿意投一部分钱"
    },
    {
      "timestamps": {
        "from": "00:04:32,122",
        "to": "00:04:34,562"
      },
      "offsets": {
        "from": 272122,
        "to": 274562
      },
      "text": "去资助这一个电影的拍摄"
    },
    {
      "timestamps": {
        "from": "00:04:34,562",
        "to": "00:04:36,122"
      },
      "offsets": {
        "from": 274562,
        "to": 276122
      },
      "text": "或者是电视剧的拍摄"
    },
    {
      "timestamps": {
        "from": "00:04:36,122",
        "to": "00:04:40,002"
      },
      "offsets": {
        "from": 276122,
        "to": 280002
      },
      "text": "这个我在我认为对未来的领域还是非常革命的"
    },
    {
      "timestamps": {
        "from": "00:04:40,002",
        "to": "00:04:43,202"
      },
      "offsets": {
        "from": 280002,
        "to": 283202
      },
      "text": "这基本上颠覆了整个产业结构"
    },
    {
      "timestamps": {
        "from": "00:04:43,202",
        "to": "00:04:44,202"
      },
      "offsets": {
        "from": 283202,
        "to": 284202
      },
      "text": "我们经常讲啊"
    },
    {
      "timestamps": {
        "from": "00:04:44,202",
        "to": "00:04:46,542"
      },
      "offsets": {
        "from": 284202,
        "to": 286542
      },
      "text": "以前啊都是所谓的"
    },
    {
      "timestamps": {
        "from": "00:04:46,542",
        "to": "00:04:49,442"
      },
      "offsets": {
        "from": 286542,
        "to": 289442
      },
      "text": "Maker to Fence"
    },
    {
      "timestamps": {
        "from": "00:04:49,442",
        "to": "00:04:51,402"
      },
      "offsets": {
        "from": 289442,
        "to": 291402
      },
      "text": "就是大家制作出来什么东西"
    },
    {
      "timestamps": {
        "from": "00:04:51,402",
        "to": "00:04:53,662"
      },
      "offsets": {
        "from": 291402,
        "to": 293662
      },
      "text": "你看什么东西对吧啊"
    },
    {
      "timestamps": {
        "from": "00:04:53,662",
        "to": "00:04:55,002"
      },
      "offsets": {
        "from": 293662,
        "to": 295002
      },
      "text": "但是我觉得在未来"
    },
    {
      "timestamps": {
        "from": "00:04:55,002",
        "to": "00:04:57,242"
      },
      "offsets": {
        "from": 295002,
        "to": 297242
      },
      "text": "我们这个时代是Fence to Maker"
    },
    {
      "timestamps": {
        "from": "00:04:56,751",
        "to": "00:04:58,311"
      },
      "offsets": {
        "from": 296751,
        "to": 298311
      },
      "text": "也是我们今天制造业"
    },
    {
      "timestamps": {
        "from": "00:04:58,311",
        "to": "00:04:59,471"
      },
      "offsets": {
        "from": 298311,
        "to": 299471
      },
      "text": "经常讲的一个新概念"
    },
    {
      "timestamps": {
        "from": "00:04:59,471",
        "to": "00:05:00,171"
      },
      "offsets": {
        "from": 299471,
        "to": 300171
      },
      "text": "叫C2M"
    },
    {
      "timestamps": {
        "from": "00:05:00,171",
        "to": "00:05:01,311"
      },
      "offsets": {
        "from": 300171,
        "to": 301311
      },
      "text": "就是Customer to Maker"
    },
    {
      "timestamps": {
        "from": "00:05:01,311",
        "to": "00:05:03,931"
      },
      "offsets": {
        "from": 301311,
        "to": 303931
      },
      "text": "就是顾客和粉丝"
    },
    {
      "timestamps": {
        "from": "00:05:03,931",
        "to": "00:05:05,351"
      },
      "offsets": {
        "from": 303931,
        "to": 305351
      },
      "text": "喜欢要什么样的产品"
    },
    {
      "timestamps": {
        "from": "00:05:05,351",
        "to": "00:05:08,211"
      },
      "offsets": {
        "from": 305351,
        "to": 308211
      },
      "text": "他们去进行一定程度的"
    },
    {
      "timestamps": {
        "from": "00:05:08,211",
        "to": "00:05:09,611"
      },
      "offsets": {
        "from": 308211,
        "to": 309611
      },
      "text": "筹资和发行"
    },
    {
      "timestamps": {
        "from": "00:05:09,611",
        "to": "00:05:13,211"
      },
      "offsets": {
        "from": 309611,
        "to": 313211
      },
      "text": "来决定上游的发行和制作"
    },
    {
      "timestamps": {
        "from": "00:05:13,211",
        "to": "00:05:15,591"
      },
      "offsets": {
        "from": 313211,
        "to": 315591
      },
      "text": "所以从某种程度上来讲"
    },
    {
      "timestamps": {
        "from": "00:05:15,591",
        "to": "00:05:17,931"
      },
      "offsets": {
        "from": 315591,
        "to": 317931
      },
      "text": "这会颠覆通过社群"
    },
    {
      "timestamps": {
        "from": "00:05:17,931",
        "to": "00:05:20,951"
      },
      "offsets": {
        "from": 317931,
        "to": 320951
      },
      "text": "以及粉丝金融的方式"
    },
    {
      "timestamps": {
        "from": "00:05:20,951",
        "to": "00:05:22,991"
      },
      "offsets": {
        "from": 320951,
        "to": 322991
      },
      "text": "去颠覆已有的"
    },
    {
      "timestamps": {
        "from": "00:05:22,991",
        "to": "00:05:24,831"
      },
      "offsets": {
        "from": 322991,
        "to": 324831
      },
      "text": "在之前人类没有互联网之前"
    },
    {
      "timestamps": {
        "from": "00:05:24,831",
        "to": "00:05:26,731"
      },
      "offsets": {
        "from": 324831,
        "to": 326731
      },
      "text": "无法完成连接"
    },
    {
      "timestamps": {
        "from": "00:05:26,731",
        "to": "00:05:29,131"
      },
      "offsets": {
        "from": 326731,
        "to": 329131
      },
      "text": "使得工业大革命的生产体系"
    },
    {
      "timestamps": {
        "from": "00:05:29,131",
        "to": "00:05:31,451"
      },
      "offsets": {
        "from": 329131,
        "to": 331451
      },
      "text": "以前工业革命时期的生产体系"
    },
    {
      "timestamps": {
        "from": "00:05:31,451",
        "to": "00:05:32,191"
      },
      "offsets": {
        "from": 331451,
        "to": 332191
      },
      "text": "为什么是这种"
    },
    {
      "timestamps": {
        "from": "00:05:32,191",
        "to": "00:05:33,871"
      },
      "offsets": {
        "from": 332191,
        "to": 333871
      },
      "text": "就比如说电影的是这种"
    },
    {
      "timestamps": {
        "from": "00:05:33,871",
        "to": "00:05:36,631"
      },
      "offsets": {
        "from": 333871,
        "to": 336631
      },
      "text": "资本来做电影进行制造呢"
    },
    {
      "timestamps": {
        "from": "00:05:36,631",
        "to": "00:05:38,871"
      },
      "offsets": {
        "from": 336631,
        "to": 338871
      },
      "text": "大家知道电影是个重资产投资行业"
    },
    {
      "timestamps": {
        "from": "00:05:38,871",
        "to": "00:05:39,651"
      },
      "offsets": {
        "from": 338871,
        "to": 339651
      },
      "text": "某种程度上"
    },
    {
      "timestamps": {
        "from": "00:05:39,651",
        "to": "00:05:41,211"
      },
      "offsets": {
        "from": 339651,
        "to": 341211
      },
      "text": "拍一部电影要花很多钱"
    },
    {
      "timestamps": {
        "from": "00:05:41,211",
        "to": "00:05:43,711"
      },
      "offsets": {
        "from": 341211,
        "to": 343711
      },
      "text": "从整个资源的调配"
    },
    {
      "timestamps": {
        "from": "00:05:43,711",
        "to": "00:05:46,511"
      },
      "offsets": {
        "from": 343711,
        "to": 346511
      },
      "text": "都不是每个人能够决定的"
    },
    {
      "timestamps": {
        "from": "00:05:46,511",
        "to": "00:05:48,651"
      },
      "offsets": {
        "from": 346511,
        "to": 348651
      },
      "text": "而现在已经不是这样了"
    },
    {
      "timestamps": {
        "from": "00:05:48,651",
        "to": "00:05:50,591"
      },
      "offsets": {
        "from": 348651,
        "to": 350591
      },
      "text": "现在互联网空前将每个人联系起来"
    },
    {
      "timestamps": {
        "from": "00:05:50,591",
        "to": "00:05:52,811"
      },
      "offsets": {
        "from": 350591,
        "to": 352811
      },
      "text": "数字虚拟货币要让全球的人"
    },
    {
      "timestamps": {
        "from": "00:05:52,811",
        "to": "00:05:56,371"
      },
      "offsets": {
        "from": 352811,
        "to": 356371
      },
      "text": "进行转账支付众筹都非常方便"
    },
    {
      "timestamps": {
        "from": "00:05:56,371",
        "to": "00:05:58,411"
      },
      "offsets": {
        "from": 356371,
        "to": 358411
      },
      "text": "然后在这样的情况下"
    },
    {
      "timestamps": {
        "from": "00:05:58,411",
        "to": "00:06:01,531"
      },
      "offsets": {
        "from": 358411,
        "to": 361531
      },
      "text": "只要信息公开项目透明"
    },
    {
      "timestamps": {
        "from": "00:06:01,531",
        "to": "00:06:03,691"
      },
      "offsets": {
        "from": 361531,
        "to": 363691
      },
      "text": "号召人有流量"
    },
    {
      "timestamps": {
        "from": "00:06:03,691",
        "to": "00:06:09,231"
      },
      "offsets": {
        "from": 363691,
        "to": 369231
      },
      "text": "这样的话就可以构造成一个全球性的项目网络"
    },
    {
      "timestamps": {
        "from": "00:06:09,231",
        "to": "00:06:10,531"
      },
      "offsets": {
        "from": 369231,
        "to": 370531
      },
      "text": "从这个角度来讲"
    },
    {
      "timestamps": {
        "from": "00:06:10,531",
        "to": "00:06:12,331"
      },
      "offsets": {
        "from": 370531,
        "to": 372331
      },
      "text": "我个人认为"
    },
    {
      "timestamps": {
        "from": "00:06:12,305",
        "to": "00:06:14,085"
      },
      "offsets": {
        "from": 372305,
        "to": 374085
      },
      "text": "他还在一个革命的前夜"
    },
    {
      "timestamps": {
        "from": "00:06:14,085",
        "to": "00:06:19,465"
      },
      "offsets": {
        "from": 374085,
        "to": 379465
      },
      "text": "甚至会对未来各行各业的发展都会非常大的影响"
    },
    {
      "timestamps": {
        "from": "00:06:19,465",
        "to": "00:06:24,905"
      },
      "offsets": {
        "from": 379465,
        "to": 384905
      },
      "text": "我自己乍一想就会有音乐影视出版"
    },
    {
      "timestamps": {
        "from": "00:06:24,905",
        "to": "00:06:30,825"
      },
      "offsets": {
        "from": 384905,
        "to": 390825
      },
      "text": "这些以前我们经常讲是通过资本策划的公司策划"
    },
    {
      "timestamps": {
        "from": "00:06:30,825",
        "to": "00:06:33,745"
      },
      "offsets": {
        "from": 390825,
        "to": 393745
      },
      "text": "制作产品最后送达每个粉丝手中"
    },
    {
      "timestamps": {
        "from": "00:06:33,745",
        "to": "00:06:36,745"
      },
      "offsets": {
        "from": 393745,
        "to": 396745
      },
      "text": "很有可能都会被这种新粉丝社区模式而颠覆"
    }
  ]
}
