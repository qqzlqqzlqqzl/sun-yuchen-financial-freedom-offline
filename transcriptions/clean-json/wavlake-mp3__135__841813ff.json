        "from": 206904,
        "to": 208464
      },
      "text": "你不能既贪图"
    },
    {
      "timestamps": {
        "from": "00:03:28,464",
        "to": "00:03:30,064"
      },
      "offsets": {
        "from": 208464,
        "to": 210064
      },
      "text": "这个规则制定"
    },
    {
      "timestamps": {
        "from": "00:03:30,064",
        "to": "00:03:32,664"
      },
      "offsets": {
        "from": 210064,
        "to": 212664
      },
      "text": "已经制定领域的安稳"
    },
    {
      "timestamps": {
        "from": "00:03:32,664",
        "to": "00:03:37,084"
      },
      "offsets": {
        "from": 212664,
        "to": 217084
      },
      "text": "同时又要要求规则尚未制定的上升通道"
    },
    {
      "timestamps": {
        "from": "00:03:37,084",
        "to": "00:03:37,764"
      },
      "offsets": {
        "from": 217084,
        "to": 217764
      },
      "text": "对吧"
    },
    {
      "timestamps": {
        "from": "00:03:37,764",
        "to": "00:03:39,504"
      },
      "offsets": {
        "from": 217764,
        "to": 219504
      },
      "text": "这个世界上哪有这么好的事"
    },
    {
      "timestamps": {
        "from": "00:03:39,504",
        "to": "00:03:42,084"
      },
      "offsets": {
        "from": 219504,
        "to": 222084
      },
      "text": "所以我个人认为"
    },
    {
      "timestamps": {
        "from": "00:03:42,084",
        "to": "00:03:45,284"
      },
      "offsets": {
        "from": 222084,
        "to": 225284
      },
      "text": "任何一个国家社会都不存在阶层孤华"
    },
    {
      "timestamps": {
        "from": "00:03:45,284",
        "to": "00:03:48,904"
      },
      "offsets": {
        "from": 225284,
        "to": 228904
      },
      "text": "而是看你愿不愿意去那个动荡"
    },
    {
      "timestamps": {
        "from": "00:03:48,904",
        "to": "00:03:51,644"
      },
      "offsets": {
        "from": 228904,
        "to": 231644
      },
      "text": "还没有制定规则的领域"
    },
    {
      "timestamps": {
        "from": "00:03:51,644",
        "to": "00:03:53,144"
      },
      "offsets": {
        "from": 231644,
        "to": 233144
      },
      "text": "当然了"
    },
    {
      "timestamps": {
        "from": "00:03:53,144",
        "to": "00:03:53,744"
      },
      "offsets": {
        "from": 233144,
        "to": 233744
      },
      "text": "我们也知道"
    },
    {
      "timestamps": {
        "from": "00:03:53,744",
        "to": "00:03:56,684"
      },
      "offsets": {
        "from": 233744,
        "to": 236684
      },
      "text": "如果你去还未制定规则领域呢"
    },
    {
      "timestamps": {
        "from": "00:03:56,684",
        "to": "00:03:59,004"
      },
      "offsets": {
        "from": 236684,
        "to": 239004
      },
      "text": "你也可能要为这些规则付出一些"
    },
    {
      "timestamps": {
        "from": "00:03:59,004",
        "to": "00:04:00,864"
      },
      "offsets": {
        "from": 239004,
        "to": 240864
      },
      "text": "为这个冒险付出一些代价"
    },
    {
      "timestamps": {
        "from": "00:04:00,864",
        "to": "00:04:01,284"
      },
      "offsets": {
        "from": 240864,
        "to": 241284
      },
      "text": "对吧"
    },
    {
      "timestamps": {
        "from": "00:04:01,284",
        "to": "00:04:03,624"
      },
      "offsets": {
        "from": 241284,
        "to": 243624
      },
      "text": "刚才我们讲了生活在王侯将下"
    },
    {
      "timestamps": {
        "from": "00:04:03,624",
        "to": "00:04:05,684"
      },
      "offsets": {
        "from": 243624,
        "to": 245684
      },
      "text": "你有种国的时代"
    },
    {
      "timestamps": {
        "from": "00:04:05,347",
        "to": "00:04:05,987"
      },
      "offsets": {
        "from": 245347,
        "to": 245987
      },
      "text": "是吧"
    },
    {
      "timestamps": {
        "from": "00:04:05,987",
        "to": "00:04:08,907"
      },
      "offsets": {
        "from": 245987,
        "to": 248907
      },
      "text": "你学着刘邦高足斩白蛇起义"
    },
    {
      "timestamps": {
        "from": "00:04:08,907",
        "to": "00:04:12,487"
      },
      "offsets": {
        "from": 248907,
        "to": 252487
      },
      "text": "也得要可能考虑有掉脑袋的风险"
    },
    {
      "timestamps": {
        "from": "00:04:12,487",
        "to": "00:04:15,747"
      },
      "offsets": {
        "from": 252487,
        "to": 255747
      },
      "text": "当然在今天我们选择创业"
    },
    {
      "timestamps": {
        "from": "00:04:15,747",
        "to": "00:04:17,107"
      },
      "offsets": {
        "from": 255747,
        "to": 257107
      },
      "text": "你有可能会失败"
    },
    {
      "timestamps": {
        "from": "00:04:17,107",
        "to": "00:04:18,467"
      },
      "offsets": {
        "from": 257107,
        "to": 258467
      },
      "text": "也会去破产"
    },
    {
      "timestamps": {
        "from": "00:04:18,467",
        "to": "00:04:20,727"
      },
      "offsets": {
        "from": 258467,
        "to": 260727
      },
      "text": "所以在冒险之前"
    },
    {
      "timestamps": {
        "from": "00:04:20,727",
        "to": "00:04:21,867"
      },
      "offsets": {
        "from": 260727,
        "to": 261867
      },
      "text": "我们要想清楚"
    },
    {
      "timestamps": {
        "from": "00:04:21,867",
        "to": "00:04:24,667"
      },
      "offsets": {
        "from": 261867,
        "to": 264667
      },
      "text": "自己有没有做好"
    },
    {
      "timestamps": {
        "from": "00:04:24,667",
        "to": "00:04:28,647"
      },
      "offsets": {
        "from": 264667,
        "to": 268647
      },
      "text": "接受失败打击与挫折的准备"
    },
    {
      "timestamps": {
        "from": "00:04:28,647",
        "to": "00:04:30,767"
      },
      "offsets": {
        "from": 268647,
        "to": 270767
      },
      "text": "所以我们经常在节目里面说"
    },
    {
      "timestamps": {
        "from": "00:04:30,767",
        "to": "00:04:33,527"
      },
      "offsets": {
        "from": 270767,
        "to": 273527
      },
      "text": "搞创业的人往往抗挫折能力"
    },
    {
      "timestamps": {
        "from": "00:04:33,527",
        "to": "00:04:34,747"
      },
      "offsets": {
        "from": 273527,
        "to": 274747
      },
      "text": "也是比较强的"
    },
    {
      "timestamps": {
        "from": "00:04:34,747",
        "to": "00:04:35,907"
      },
      "offsets": {
        "from": 274747,
        "to": 275907
      },
      "text": "同时呢"
    },
    {
      "timestamps": {
        "from": "00:04:35,907",
        "to": "00:04:40,227"
      },
      "offsets": {
        "from": 275907,
        "to": 280227
      },
      "text": "他也为自己的抗挫折准备了一些客观条件"
    },
    {
      "timestamps": {
        "from": "00:04:40,227",
        "to": "00:04:44,327"
      },
      "offsets": {
        "from": 280227,
        "to": 284327
      },
      "text": "比如说咱们还是以孙宇晨为例子来举例"
    },
    {
      "timestamps": {
        "from": "00:04:44,327",
        "to": "00:04:49,067"
      },
      "offsets": {
        "from": 284327,
        "to": 289067
      },
      "text": "你看孙宇晨这短短五年时间遇到的挫折不要太多"
    },
    {
      "timestamps": {
        "from": "00:04:49,067",
        "to": "00:04:50,247"
      },
      "offsets": {
        "from": 289067,
        "to": 290247
      },
      "text": "当然了"
    },
    {
      "timestamps": {
        "from": "00:04:50,247",
        "to": "00:04:52,907"
      },
      "offsets": {
        "from": 290247,
        "to": 292907
      },
      "text": "我也为自己创造了一个非常好的抗挫条件"
    },
    {
      "timestamps": {
        "from": "00:04:52,907",
        "to": "00:04:53,847"
      },
      "offsets": {
        "from": 292907,
        "to": 293847
      },
      "text": "为什么呢"
    },
    {
      "timestamps": {
        "from": "00:04:53,847",
        "to": "00:04:54,407"
      },
      "offsets": {
        "from": 293847,
        "to": 294407
      },
      "text": "你看孙宇晨"
    },
    {
      "timestamps": {
        "from": "00:04:54,407",
        "to": "00:04:56,847"
      },
      "offsets": {
        "from": 294407,
        "to": 296847
      },
      "text": "我这五年创业和未来五年创业"
    },
    {
      "timestamps": {
        "from": "00:04:56,847",
        "to": "00:04:59,487"
      },
      "offsets": {
        "from": 296847,
        "to": 299487
      },
      "text": "咱都是坚持着90后不买房"
    },
    {
      "timestamps": {
        "from": "00:04:59,487",
        "to": "00:05:00,027"
      },
      "offsets": {
        "from": 299487,
        "to": 300027
      },
      "text": "不买车"
    },
    {
      "timestamps": {
        "from": "00:05:00,027",
        "to": "00:05:00,547"
      },
      "offsets": {
        "from": 300027,
        "to": 300547
      },
      "text": "不结婚"
    },
    {
      "timestamps": {
        "from": "00:05:00,547",
        "to": "00:05:00,907"
      },
      "offsets": {
        "from": 300547,
        "to": 300907
      },
      "text": "是吧"
    },
    {
      "timestamps": {
        "from": "00:05:00,907",
        "to": "00:05:01,967"
      },
      "offsets": {
        "from": 300907,
        "to": 301967
      },
      "text": "一人吃饱"
    },
    {
      "timestamps": {
        "from": "00:05:01,967",
        "to": "00:05:02,747"
      },
      "offsets": {
        "from": 301967,
        "to": 302747
      },
      "text": "全家不饿"
    },
    {
      "timestamps": {
        "from": "00:05:02,747",
        "to": "00:05:03,647"
      },
      "offsets": {
        "from": 302747,
        "to": 303647
      },
      "text": "你说我孙宇晨"
    },
    {
      "timestamps": {
        "from": "00:05:03,647",
        "to": "00:05:05,187"
      },
      "offsets": {
        "from": 303647,
        "to": 305187
      },
      "text": "如果想吃点苦"
    },
    {
      "timestamps": {
        "from": "00:05:05,187",
        "to": "00:05:08,307"
      },
      "offsets": {
        "from": 305187,
        "to": 308307
      },
      "text": "其实我哪怕一个月一千块钱"
    },
    {
      "timestamps": {
        "from": "00:05:08,307",
        "to": "00:05:09,267"
      },
      "offsets": {
        "from": 308307,
        "to": 309267
      },
      "text": "也都能活着呗"
    },
    {
      "timestamps": {
        "from": "00:05:09,267",
        "to": "00:05:10,267"
      },
      "offsets": {
        "from": 309267,
        "to": 310267
      },
      "text": "不就吃饭吗"
    },
    {
      "timestamps": {
        "from": "00:05:10,267",
        "to": "00:05:10,647"
      },
      "offsets": {
        "from": 310267,
        "to": 310647
      },
      "text": "对不对"
    },
    {
      "timestamps": {
        "from": "00:05:10,647",
        "to": "00:05:12,207"
      },
      "offsets": {
        "from": 310647,
        "to": 312207
      },
      "text": "实在不就躺工思睡了"
    },
    {
      "timestamps": {
        "from": "00:05:12,207",
        "to": "00:05:12,827"
      },
      "offsets": {
        "from": 312207,
        "to": 312827
      },
      "text": "对吧"
    },
    {
      "timestamps": {
        "from": "00:05:12,827",
        "to": "00:05:13,407"
      },
      "offsets": {
        "from": 312827,
        "to": 313407
      },
      "text": "也一点"
    },
    {
      "timestamps": {
        "from": "00:05:13,811",
        "to": "00:05:15,231"
      },
      "offsets": {
        "from": 313811,
        "to": 315231
      },
      "text": "不消耗啊对吧"
    },
    {
      "timestamps": {
        "from": "00:05:15,231",
        "to": "00:05:17,231"
      },
      "offsets": {
        "from": 315231,
        "to": 317231
      },
      "text": "确实因为我记得以前啊"
    },
    {
      "timestamps": {
        "from": "00:05:17,231",
        "to": "00:05:18,391"
      },
      "offsets": {
        "from": 317231,
        "to": 318391
      },
      "text": "我一些朋友啊"
    },
    {
      "timestamps": {
        "from": "00:05:18,391",
        "to": "00:05:19,511"
      },
      "offsets": {
        "from": 318391,
        "to": 319511
      },
      "text": "创业瞻前顾后"
    },
    {
      "timestamps": {
        "from": "00:05:19,511",
        "to": "00:05:20,771"
      },
      "offsets": {
        "from": 319511,
        "to": 320771
      },
      "text": "总是想哎呀"
    },
    {
      "timestamps": {
        "from": "00:05:20,771",
        "to": "00:05:22,471"
      },
      "offsets": {
        "from": 320771,
        "to": 322471
      },
      "text": "要老婆孩子怎么养啊"
    },
    {
      "timestamps": {
        "from": "00:05:22,471",
        "to": "00:05:24,211"
      },
      "offsets": {
        "from": 322471,
        "to": 324211
      },
      "text": "要父母要负担呢"
    },
    {
      "timestamps": {
        "from": "00:05:24,211",
        "to": "00:05:25,211"
      },
      "offsets": {
        "from": 324211,
        "to": 325211
      },
      "text": "要买房买车"
    },
    {
      "timestamps": {
        "from": "00:05:25,211",
        "to": "00:05:26,511"
      },
      "offsets": {
        "from": 325211,
        "to": 326511
      },
      "text": "供房供车呀"
    },
    {
      "timestamps": {
        "from": "00:05:26,511",
        "to": "00:05:28,451"
      },
      "offsets": {
        "from": 326511,
        "to": 328451
      },
      "text": "现金流如此紧张"
    },
    {
      "timestamps": {
        "from": "00:05:28,451",
        "to": "00:05:29,591"
      },
      "offsets": {
        "from": 328451,
        "to": 329591
      },
      "text": "自然是没有办法创业"
    },
    {
      "timestamps": {
        "from": "00:05:29,591",
        "to": "00:05:31,531"
      },
      "offsets": {
        "from": 329591,
        "to": 331531
      },
      "text": "像我孙宇晨一开始创业的时候"
    },
    {
      "timestamps": {
        "from": "00:05:31,531",
        "to": "00:05:32,791"
      },
      "offsets": {
        "from": 331531,
        "to": 332791
      },
      "text": "本来就一无所有了"
    },
    {
      "timestamps": {
        "from": "00:05:32,791",
        "to": "00:05:34,911"
      },
      "offsets": {
        "from": 332791,
        "to": 334911
      },
      "text": "每天除了吃饭之外"
    },
    {
      "timestamps": {
        "from": "00:05:34,911",
        "to": "00:05:36,331"
      },
      "offsets": {
        "from": 334911,
        "to": 336331
      },
      "text": "基本没有任何损耗"
    },
    {
      "timestamps": {
        "from": "00:05:36,331",
        "to": "00:05:37,911"
      },
      "offsets": {
        "from": 336331,
        "to": 337911
      },
      "text": "所以我自己创业"
    },
    {
      "timestamps": {
        "from": "00:05:37,911",
        "to": "00:05:39,771"
      },
      "offsets": {
        "from": 337911,
        "to": 339771
      },
      "text": "其实哪一台电脑就是创业"
    },
    {
      "timestamps": {
        "from": "00:05:39,771",
        "to": "00:05:42,411"
      },
      "offsets": {
        "from": 339771,
        "to": 342411
      },
      "text": "最惨的时候"
    },
    {
      "timestamps": {
        "from": "00:05:42,411",
        "to": "00:05:44,091"
      },
      "offsets": {
        "from": 342411,
        "to": 344091
      },
      "text": "我就自己躲在宿舍里面"
    },
    {
      "timestamps": {
        "from": "00:05:44,091",
        "to": "00:05:45,671"
      },
      "offsets": {
        "from": 344091,
        "to": 345671
      },
      "text": "拿台电脑不也是创业吗"
    },
    {
      "timestamps": {
        "from": "00:05:45,671",
        "to": "00:05:46,111"
      },
      "offsets": {
        "from": 345671,
        "to": 346111
      },
      "text": "对吧"
    },
    {
      "timestamps": {
        "from": "00:05:46,111",
        "to": "00:05:47,371"
      },
      "offsets": {
        "from": 346111,
        "to": 347371
      },
      "text": "所以对我来说"
    },
    {
      "timestamps": {
        "from": "00:05:47,371",
        "to": "00:05:49,091"
      },
      "offsets": {
        "from": 347371,
        "to": 349091
      },
      "text": "创业门槛真是相当低"
    },
    {
      "timestamps": {
        "from": "00:05:49,091",
        "to": "00:05:50,951"
      },
      "offsets": {
        "from": 349091,
        "to": 350951
      },
      "text": "在这五年期间"
    },
    {
      "timestamps": {
        "from": "00:05:50,951",
        "to": "00:05:52,951"
      },
      "offsets": {
        "from": 350951,
        "to": 352951
      },
      "text": "我们也遇到过很多挫折"
    },
    {
      "timestamps": {
        "from": "00:05:52,951",
        "to": "00:05:53,951"
      },
      "offsets": {
        "from": 352951,
        "to": 353951
      },
      "text": "我经常干着干着"
    },
    {
      "timestamps": {
        "from": "00:05:53,951",
        "to": "00:05:55,411"
      },
      "offsets": {
        "from": 353951,
        "to": 355411
      },
      "text": "就变成光管司令了"
    },
    {
      "timestamps": {
        "from": "00:05:55,411",
        "to": "00:05:56,951"
      },
      "offsets": {
        "from": 355411,
        "to": 356951
      },
      "text": "员工跑光了"
    },
    {
      "timestamps": {
        "from": "00:05:56,951",
        "to": "00:05:59,591"
      },
      "offsets": {
        "from": 356951,
        "to": 359591
      },
      "text": "这种事情我也经历过好几次"
    },
    {
      "timestamps": {
        "from": "00:05:59,591",
        "to": "00:06:01,291"
      },
      "offsets": {
        "from": 359591,
        "to": 361291
      },
      "text": "而且甚至有的员工"
    },
    {
      "timestamps": {
        "from": "00:06:01,291",
        "to": "00:06:02,611"
      },
      "offsets": {
        "from": 361291,
        "to": 362611
      },
      "text": "也觉得我是个坏人"
    },
    {
      "timestamps": {
        "from": "00:06:02,611",
        "to": "00:06:03,991"
      },
      "offsets": {
        "from": 362611,
        "to": 363991
      },
      "text": "觉得我是个骗子"
    },
    {
      "timestamps": {
        "from": "00:06:03,991",
        "to": "00:06:05,071"
      },
      "offsets": {
        "from": 363991,
        "to": 365071
      },
      "text": "因为你说好"
    },
    {
      "timestamps": {
        "from": "00:06:05,071",
        "to": "00:06:06,191"
      },
      "offsets": {
        "from": 365071,
        "to": 366191
      },
      "text": "待我们创业成功呢"
    },
    {
      "timestamps": {
        "from": "00:06:06,191",
        "to": "00:06:07,471"
      },
      "offsets": {
        "from": 366191,
        "to": 367471
      },
      "text": "你怎么老失败呢"
    },
    {
      "timestamps": {
        "from": "00:06:07,471",
        "to": "00:06:07,931"
      },
      "offsets": {
        "from": 367471,
        "to": 367931
      },
      "text": "对吧"
    },
    {
      "timestamps": {
        "from": "00:06:07,931",
        "to": "00:06:09,191"
      },
      "offsets": {
        "from": 367931,
        "to": 369191
      },
      "text": "就这种事"
    },
    {
      "timestamps": {
        "from": "00:06:09,191",
        "to": "00:06:10,911"
      },
      "offsets": {
        "from": 369191,
        "to": 370911
      },
      "text": "我也经历过无数次了"
    },
    {
      "timestamps": {
        "from": "00:06:10,911",
        "to": "00:06:12,231"
      },
      "offsets": {
        "from": 370911,
        "to": 372231
      },
      "text": "我觉得呢"
    },
    {
      "timestamps": {
        "from": "00:06:12,231",
        "to": "00:06:13,191"
      },
      "offsets": {
        "from": 372231,
        "to": 373191
      },
      "text": "脸皮太薄"
    },
    {
      "timestamps": {
        "from": "00:06:13,191",
        "to": "00:06:14,451"
      },
      "offsets": {
        "from": 373191,
        "to": 374451
      },
      "text": "玻璃心的人呢"
    },
    {
      "timestamps": {
        "from": "00:06:14,451",
        "to": "00:06:15,571"
      },
      "offsets": {
        "from": 374451,
        "to": 375571
      },
      "text": "不太适合创业"
    },
    {
      "timestamps": {
        "from": "00:06:15,571",
        "to": "00:06:17,071"
      },
      "offsets": {
        "from": 375571,
        "to": 377071
      },
      "text": "或者进入创业公司"
    },
    {
      "timestamps": {
        "from": "00:06:17,071",
        "to": "00:06:18,051"
      },
      "offsets": {
        "from": 377071,
        "to": 378051
      },
      "text": "甚至呢"
    },
    {
      "timestamps": {
        "from": "00:06:18,051",
        "to": "00:06:21,251"
      },
      "offsets": {
        "from": 378051,
        "to": 381251
      },
      "text": "也不适合在所谓的规则制定领域工作啊"
    },
    {
      "timestamps": {
        "from": "00:06:21,251",
        "to": "00:06:22,771"
      },
      "offsets": {
        "from": 381251,
        "to": 382771
      },
      "text": "因为这时候啊"
    },
    {
      "timestamps": {
        "from": "00:06:22,771",
        "to": "00:06:24,271"
      },
      "offsets": {
        "from": 382771,
        "to": 384271
      },
      "text": "你的冒险你冒不起吧"
    },
    {
      "timestamps": {
        "from": "00:06:25,257",
        "to": "00:06:28,257"
      },
      "offsets": {
        "from": 385257,
        "to": 388257
      },
      "text": "在规则上面制定的领域往往会有很多冲突"
    },
    {
      "timestamps": {
        "from": "00:06:28,257",
        "to": "00:06:29,137"
      },
      "offsets": {
        "from": 388257,
        "to": 389137
      },
      "text": "就需要奋斗"
    },
    {
      "timestamps": {
        "from": "00:06:29,137",
        "to": "00:06:31,397"
      },
      "offsets": {
        "from": 389137,
        "to": 391397
      },
      "text": "奋斗往往就需要努力"
    },
    {
      "timestamps": {
        "from": "00:06:31,397",
        "to": "00:06:34,537"
      },
      "offsets": {
        "from": 391397,
        "to": 394537
      },
      "text": "不可能说我图的就是个现实安稳"
    },
    {
      "timestamps": {
        "from": "00:06:34,537",
        "to": "00:06:36,777"
      },
      "offsets": {
        "from": 394537,
        "to": 396777
      },
      "text": "过上小确信的日子"
    },
    {
      "timestamps": {
        "from": "00:06:36,777",
        "to": "00:06:37,737"
      },
      "offsets": {
        "from": 396777,
        "to": 397737
      },
      "text": "这怎么可能呢"
    },
    {
      "timestamps": {
        "from": "00:06:37,737",
        "to": "00:06:41,817"
      },
      "offsets": {
        "from": 397737,
        "to": 401817
      },
      "text": "我们经常遇到一些创业公司的员工进来说"
    },
    {
      "timestamps": {
        "from": "00:06:41,817",
        "to": "00:06:44,037"
      },
      "offsets": {
        "from": 401817,
        "to": 404037
      },
      "text": "语晨我对公司做没什么要求"
    },
    {
      "timestamps": {
        "from": "00:06:44,037",
        "to": "00:06:45,797"
      },
      "offsets": {
        "from": 404037,
        "to": 405797
      },
      "text": "就希望能比较稳定"
    },
    {
      "timestamps": {
        "from": "00:06:45,797",
        "to": "00:06:46,617"
      },
      "offsets": {
        "from": 405797,
        "to": 406617
      },
      "text": "不用努力"
    },
    {
      "timestamps": {
        "from": "00:06:46,617",
        "to": "00:06:47,037"
      },
      "offsets": {
        "from": 406617,
        "to": 407037
      },
      "text": "是吧"
    },
    {
      "timestamps": {
        "from": "00:06:47,037",
        "to": "00:06:49,077"
      },
      "offsets": {
        "from": 407037,
        "to": 409077
      },
      "text": "能拿一份好的工资"
    },
    {
      "timestamps": {
        "from": "00:06:49,077",
        "to": "00:06:50,797"
      },
      "offsets": {
        "from": 409077,
        "to": 410797
      },
      "text": "这是我对这个工作的要求"
    },
    {
      "timestamps": {
        "from": "00:06:50,797",
        "to": "00:06:52,557"
      },
      "offsets": {
        "from": 410797,
        "to": 412557
      },
      "text": "这就是不可能的了"
    },
    {
      "timestamps": {
        "from": "00:06:52,557",
        "to": "00:06:53,237"
      },
      "offsets": {
        "from": 412557,
        "to": 413237
      },
      "text": "是吧"
    },
    {
      "timestamps": {
        "from": "00:06:53,237",
        "to": "00:07:22,377"
      },
      "offsets": {
        "from": 413237,
        "to": 442377
      },
      "text": "毛主席说过,革命不是请客吃饭,不是做文章,不是绘画绣花,不能那样雅致,不能那样从容不迫,文质彬彬,那样温良恭俭让,革命是暴动,是一个阶级推翻一个阶级的暴力的行动,创业跟革命在这个程度上是一样的,是一个公司去打破,去推翻已有公司规则的一种暴力的过程。"
    },
    {
      "timestamps": {
        "from": "00:07:23,237",
        "to": "00:07:26,037"
      },
      "offsets": {
        "from": 443237,
        "to": 446037
      },
      "text": "所以创业当然不是你每天朝九晚五"
    },
    {
      "timestamps": {
        "from": "00:07:26,037",
        "to": "00:07:27,277"
      },
      "offsets": {
        "from": 446037,
        "to": 447277
      },
      "text": "上班搞一搞"
    },
    {
      "timestamps": {
        "from": "00:07:27,277",
        "to": "00:07:30,837"
      },
      "offsets": {
        "from": 447277,
        "to": 450837
      },
      "text": "随便回家睡一觉就能搞定的"
    },
    {
      "timestamps": {
        "from": "00:07:30,837",
        "to": "00:07:33,157"
      },
      "offsets": {
        "from": 450837,
        "to": 453157
      },
      "text": "肯定是要付出相应的代价"
    },
    {
      "timestamps": {
        "from": "00:07:33,157",
        "to": "00:07:34,737"
      },
      "offsets": {
        "from": 453157,
        "to": 454737
      },
      "text": "承担相应的风险"
    },
    {
      "timestamps": {
        "from": "00:07:34,737",
        "to": "00:07:35,557"
      },
      "offsets": {
        "from": 454737,
        "to": 455557
      },
      "text": "当然"
    },
    {
      "timestamps": {
        "from": "00:07:35,557",
        "to": "00:07:39,037"
      },
      "offsets": {
        "from": 455557,
        "to": 459037
      },
      "text": "它的回报也将是非常丰厚的"
    }
  ]
}
