    {
      "timestamps": {
        "from": "00:03:39,272",
        "to": "00:03:41,732"
      },
      "offsets": {
        "from": 219272,
        "to": 221732
      },
      "text": "这就是一个我们典型讲的"
    },
    {
      "timestamps": {
        "from": "00:03:41,732",
        "to": "00:03:44,232"
      },
      "offsets": {
        "from": 221732,
        "to": 224232
      },
      "text": "规则尚未制定的领域"
    },
    {
      "timestamps": {
        "from": "00:03:44,232",
        "to": "00:03:46,872"
      },
      "offsets": {
        "from": 224232,
        "to": 226872
      },
      "text": "因此胡春华一进去"
    },
    {
      "timestamps": {
        "from": "00:03:46,371",
        "to": "00:03:49,511"
      },
      "offsets": {
        "from": 226371,
        "to": 229511
      },
      "text": "很快我记得二十多岁"
    },
    {
      "timestamps": {
        "from": "00:03:49,511",
        "to": "00:03:52,551"
      },
      "offsets": {
        "from": 229511,
        "to": 232551
      },
      "text": "胡春华就已经到了附庭级"
    },
    {
      "timestamps": {
        "from": "00:03:52,551",
        "to": "00:03:57,911"
      },
      "offsets": {
        "from": 232551,
        "to": 237911
      },
      "text": "这在很多规则既定领域是根本无法想象的"
    },
    {
      "timestamps": {
        "from": "00:03:57,911",
        "to": "00:04:00,031"
      },
      "offsets": {
        "from": 237911,
        "to": 240031
      },
      "text": "胡春华当年的同学"
    },
    {
      "timestamps": {
        "from": "00:04:00,031",
        "to": "00:04:02,691"
      },
      "offsets": {
        "from": 240031,
        "to": 242691
      },
      "text": "菊大多春并没有主动请缨留在西藏"
    },
    {
      "timestamps": {
        "from": "00:04:02,691",
        "to": "00:04:08,411"
      },
      "offsets": {
        "from": 242691,
        "to": 248411
      },
      "text": "而是主动请缨将留在北京这个艰巨的任务交给我吧"
    },
    {
      "timestamps": {
        "from": "00:04:08,411",
        "to": "00:04:09,011"
      },
      "offsets": {
        "from": 248411,
        "to": 249011
      },
      "text": "对吧"
    },
    {
      "timestamps": {
        "from": "00:04:09,011",
        "to": "00:04:11,111"
      },
      "offsets": {
        "from": 249011,
        "to": 251111
      },
      "text": "留在北京是挺艰巨的"
    },
    {
      "timestamps": {
        "from": "00:04:11,111",
        "to": "00:04:14,031"
      },
      "offsets": {
        "from": 251111,
        "to": 254031
      },
      "text": "北京光处级干部就好几万人"
    },
    {
      "timestamps": {
        "from": "00:04:14,031",
        "to": "00:04:14,471"
      },
      "offsets": {
        "from": 254031,
        "to": 254471
      },
      "text": "是吧"
    },
    {
      "timestamps": {
        "from": "00:04:14,471",
        "to": "00:04:16,531"
      },
      "offsets": {
        "from": 254471,
        "to": 256531
      },
      "text": "你一刚进去"
    },
    {
      "timestamps": {
        "from": "00:04:16,531",
        "to": "00:04:18,131"
      },
      "offsets": {
        "from": 256531,
        "to": 258131
      },
      "text": "从科研干起"
    },
    {
      "timestamps": {
        "from": "00:04:18,131",
        "to": "00:04:21,031"
      },
      "offsets": {
        "from": 258131,
        "to": 261031
      },
      "text": "就跟这好几万的初级干部"
    },
    {
      "timestamps": {
        "from": "00:04:21,031",
        "to": "00:04:22,211"
      },
      "offsets": {
        "from": 261031,
        "to": 262211
      },
      "text": "你就等着排队吧"
    },
    {
      "timestamps": {
        "from": "00:04:22,211",
        "to": "00:04:24,391"
      },
      "offsets": {
        "from": 262211,
        "to": 264391
      },
      "text": "北京的规则早就制定好了"
    },
    {
      "timestamps": {
        "from": "00:04:24,391",
        "to": "00:04:26,111"
      },
      "offsets": {
        "from": 264391,
        "to": 266111
      },
      "text": "资源也分配好了"
    },
    {
      "timestamps": {
        "from": "00:04:26,111",
        "to": "00:04:28,311"
      },
      "offsets": {
        "from": 266111,
        "to": 268311
      },
      "text": "二十多岁别说升到副厅"
    },
    {
      "timestamps": {
        "from": "00:04:28,311",
        "to": "00:04:30,671"
      },
      "offsets": {
        "from": 268311,
        "to": 270671
      },
      "text": "你二十多岁能不能排队"
    },
    {
      "timestamps": {
        "from": "00:04:30,671",
        "to": "00:04:32,151"
      },
      "offsets": {
        "from": 270671,
        "to": 272151
      },
      "text": "在北京分辆自行车"
    },
    {
      "timestamps": {
        "from": "00:04:32,151",
        "to": "00:04:32,991"
      },
      "offsets": {
        "from": 272151,
        "to": 272991
      },
      "text": "是吧"
    },
    {
      "timestamps": {
        "from": "00:04:32,991",
        "to": "00:04:33,991"
      },
      "offsets": {
        "from": 272991,
        "to": 273991
      },
      "text": "都未必的"
    },
    {
      "timestamps": {
        "from": "00:04:33,991",
        "to": "00:04:35,511"
      },
      "offsets": {
        "from": 273991,
        "to": 275511
      },
      "text": "更别说分房了"
    },
    {
      "timestamps": {
        "from": "00:04:35,511",
        "to": "00:04:37,711"
      },
      "offsets": {
        "from": 275511,
        "to": 277711
      },
      "text": "所以我们可以看到"
    },
    {
      "timestamps": {
        "from": "00:04:37,711",
        "to": "00:04:40,691"
      },
      "offsets": {
        "from": 277711,
        "to": 280691
      },
      "text": "即便到体制内去从政"
    },
    {
      "timestamps": {
        "from": "00:04:40,691",
        "to": "00:04:43,191"
      },
      "offsets": {
        "from": 280691,
        "to": 283191
      },
      "text": "也要到规则尚未制定"
    },
    {
      "timestamps": {
        "from": "00:04:43,191",
        "to": "00:04:44,391"
      },
      "offsets": {
        "from": 283191,
        "to": 284391
      },
      "text": "需要你的地方"
    },
    {
      "timestamps": {
        "from": "00:04:44,391",
        "to": "00:04:47,471"
      },
      "offsets": {
        "from": 284391,
        "to": 287471
      },
      "text": "才能真正弯道超车"
    },
    {
      "timestamps": {
        "from": "00:04:47,471",
        "to": "00:04:49,351"
      },
      "offsets": {
        "from": 287471,
        "to": 289351
      },
      "text": "规则已经"
    },
    {
      "timestamps": {
        "from": "00:04:49,351",
        "to": "00:04:51,651"
      },
      "offsets": {
        "from": 289351,
        "to": 291651
      },
      "text": "既定好的领域不仅在从政领域"
    },
    {
      "timestamps": {
        "from": "00:04:51,651",
        "to": "00:04:53,351"
      },
      "offsets": {
        "from": 291651,
        "to": 293351
      },
      "text": "是缺乏性感的"
    },
    {
      "timestamps": {
        "from": "00:04:53,351",
        "to": "00:04:55,571"
      },
      "offsets": {
        "from": 293351,
        "to": 295571
      },
      "text": "缺乏上升通道"
    },
    {
      "timestamps": {
        "from": "00:04:55,571",
        "to": "00:04:57,091"
      },
      "offsets": {
        "from": 295571,
        "to": 297091
      },
      "text": "在资本市场"
    },
    {
      "timestamps": {
        "from": "00:04:57,091",
        "to": "00:04:59,011"
      },
      "offsets": {
        "from": 297091,
        "to": 299011
      },
      "text": "也通常缺乏想象力"
    },
    {
      "timestamps": {
        "from": "00:04:59,080",
        "to": "00:05:01,080"
      },
      "offsets": {
        "from": 299080,
        "to": 301080
      },
      "text": "这就为什么我们经常说"
    },
    {
      "timestamps": {
        "from": "00:05:01,080",
        "to": "00:05:03,040"
      },
      "offsets": {
        "from": 301080,
        "to": 303040
      },
      "text": "在投资的时候"
    },
    {
      "timestamps": {
        "from": "00:05:03,040",
        "to": "00:05:05,840"
      },
      "offsets": {
        "from": 303040,
        "to": 305840
      },
      "text": "经常说一个行业是不是sexy"
    },
    {
      "timestamps": {
        "from": "00:05:05,840",
        "to": "00:05:07,800"
      },
      "offsets": {
        "from": 305840,
        "to": 307800
      },
      "text": "就用的这个英文单词"
    },
    {
      "timestamps": {
        "from": "00:05:07,800",
        "to": "00:05:09,140"
      },
      "offsets": {
        "from": 307800,
        "to": 309140
      },
      "text": "是不是足够性感"
    },
    {
      "timestamps": {
        "from": "00:05:09,140",
        "to": "00:05:11,320"
      },
      "offsets": {
        "from": 309140,
        "to": 311320
      },
      "text": "而很多传统行业"
    },
    {
      "timestamps": {
        "from": "00:05:11,320",
        "to": "00:05:13,100"
      },
      "offsets": {
        "from": 311320,
        "to": 313100
      },
      "text": "P值为什么一直那么低"
    },
    {
      "timestamps": {
        "from": "00:05:13,100",
        "to": "00:05:14,880"
      },
      "offsets": {
        "from": 313100,
        "to": 314880
      },
      "text": "就是因为这个道理"
    },
    {
      "timestamps": {
        "from": "00:05:14,880",
        "to": "00:05:17,600"
      },
      "offsets": {
        "from": 314880,
        "to": 317600
      },
      "text": "如果这个行业是个西洋行业"
    },
    {
      "timestamps": {
        "from": "00:05:17,600",
        "to": "00:05:18,480"
      },
      "offsets": {
        "from": 317600,
        "to": 318480
      },
      "text": "不够性感"
    },
    {
      "timestamps": {
        "from": "00:05:18,480",
        "to": "00:05:20,680"
      },
      "offsets": {
        "from": 318480,
        "to": 320680
      },
      "text": "一眼能看到30年"
    },
    {
      "timestamps": {
        "from": "00:05:20,680",
        "to": "00:05:22,960"
      },
      "offsets": {
        "from": 320680,
        "to": 322960
      },
      "text": "投资人往往对这个行业"
    },
    {
      "timestamps": {
        "from": "00:05:22,960",
        "to": "00:05:25,440"
      },
      "offsets": {
        "from": 322960,
        "to": 325440
      },
      "text": "就是彻底丧失信心了"
    },
    {
      "timestamps": {
        "from": "00:05:25,440",
        "to": "00:05:26,900"
      },
      "offsets": {
        "from": 325440,
        "to": 326900
      },
      "text": "而互联网"
    },
    {
      "timestamps": {
        "from": "00:05:26,900",
        "to": "00:05:28,360"
      },
      "offsets": {
        "from": 326900,
        "to": 328360
      },
      "text": "反观互联网公司"
    },
    {
      "timestamps": {
        "from": "00:05:28,360",
        "to": "00:05:30,400"
      },
      "offsets": {
        "from": 328360,
        "to": 330400
      },
      "text": "一个比一个会讲故事"
    },
    {
      "timestamps": {
        "from": "00:05:30,400",
        "to": "00:05:31,540"
      },
      "offsets": {
        "from": 330400,
        "to": 331540
      },
      "text": "能让你感觉"
    },
    {
      "timestamps": {
        "from": "00:05:31,540",
        "to": "00:05:32,820"
      },
      "offsets": {
        "from": 331540,
        "to": 332820
      },
      "text": "别说30年了"
    },
    {
      "timestamps": {
        "from": "00:05:32,820",
        "to": "00:05:35,560"
      },
      "offsets": {
        "from": 332820,
        "to": 335560
      },
      "text": "就三五年都大不一样"
    },
    {
      "timestamps": {
        "from": "00:05:35,560",
        "to": "00:05:38,620"
      },
      "offsets": {
        "from": 335560,
        "to": 338620
      },
      "text": "一两年都能进入一个新时代"
    },
    {
      "timestamps": {
        "from": "00:05:38,620",
        "to": "00:05:39,660"
      },
      "offsets": {
        "from": 338620,
        "to": 339660
      },
      "text": "比方说"
    },
    {
      "timestamps": {
        "from": "00:05:39,660",
        "to": "00:05:42,100"
      },
      "offsets": {
        "from": 339660,
        "to": 342100
      },
      "text": "无论是亚马逊的云计算"
    },
    {
      "timestamps": {
        "from": "00:05:42,100",
        "to": "00:05:43,400"
      },
      "offsets": {
        "from": 342100,
        "to": 343400
      },
      "text": "无人超市"
    },
    {
      "timestamps": {
        "from": "00:05:43,400",
        "to": "00:05:46,120"
      },
      "offsets": {
        "from": 343400,
        "to": 346120
      },
      "text": "最近马云爸爸也把这个超过来了"
    },
    {
      "timestamps": {
        "from": "00:05:46,120",
        "to": "00:05:48,040"
      },
      "offsets": {
        "from": 346120,
        "to": 348040
      },
      "text": "在中国也搞了无人超市"
    },
    {
      "timestamps": {
        "from": "00:05:48,040",
        "to": "00:05:49,380"
      },
      "offsets": {
        "from": 348040,
        "to": 349380
      },
      "text": "这无人超市"
    },
    {
      "timestamps": {
        "from": "00:05:49,380",
        "to": "00:05:49,960"
      },
      "offsets": {
        "from": 349380,
        "to": 349960
      },
      "text": "我听说"
    },
    {
      "timestamps": {
        "from": "00:05:49,960",
        "to": "00:05:52,360"
      },
      "offsets": {
        "from": 349960,
        "to": 352360
      },
      "text": "这个大妈排成排"
    },
    {
      "timestamps": {
        "from": "00:05:52,360",
        "to": "00:05:54,320"
      },
      "offsets": {
        "from": 352360,
        "to": 354320
      },
      "text": "排队进无人超市"
    },
    {
      "timestamps": {
        "from": "00:05:54,320",
        "to": "00:05:55,980"
      },
      "offsets": {
        "from": 354320,
        "to": 355980
      },
      "text": "把无人超市变得"
    },
    {
      "timestamps": {
        "from": "00:05:55,980",
        "to": "00:05:58,420"
      },
      "offsets": {
        "from": 355980,
        "to": 358420
      },
      "text": "应该是全世界人最多的超市"
    },
    {
      "timestamps": {
        "from": "00:05:58,420",
        "to": "00:06:02,200"
      },
      "offsets": {
        "from": 358420,
        "to": 362200
      },
      "text": "大家可能看了网上一些图"
    },
    {
      "timestamps": {
        "from": "00:06:02,200",
        "to": "00:06:04,740"
      },
      "offsets": {
        "from": 362200,
        "to": 364740
      },
      "text": "大妈们并排在无人超市里面"
    },
    {
      "timestamps": {
        "from": "00:06:04,740",
        "to": "00:06:05,720"
      },
      "offsets": {
        "from": 364740,
        "to": 365720
      },
      "text": "雨上观金"
    },
    {
      "timestamps": {
        "from": "00:06:05,720",
        "to": "00:06:06,060"
      },
      "offsets": {
        "from": 365720,
        "to": 366060
      },
      "text": "是吧"
    },
    {
      "timestamps": {
        "from": "00:06:06,060",
        "to": "00:06:07,560"
      },
      "offsets": {
        "from": 366060,
        "to": 367560
      },
      "text": "谭孝坚是吧"
    },
    {
      "timestamps": {
        "from": "00:06:07,560",
        "to": "00:06:09,660"
      },
      "offsets": {
        "from": 367560,
        "to": 369660
      },
      "text": "马云爸爸超市灰飞烟灭"
    },
    {
      "timestamps": {
        "from": "00:06:09,660",
        "to": "00:06:10,460"
      },
      "offsets": {
        "from": 369660,
        "to": 370460
      },
      "text": "是吧"
    },
    {
      "timestamps": {
        "from": "00:06:10,460",
        "to": "00:06:13,920"
      },
      "offsets": {
        "from": 370460,
        "to": 373920
      },
      "text": "说马云这个没有败给这个亚马逊"
    },
    {
      "timestamps": {
        "from": "00:06:13,920",
        "to": "00:06:15,340"
      },
      "offsets": {
        "from": 373920,
        "to": 375340
      },
      "text": "败给了中国大妈"
    },
    {
      "timestamps": {
        "from": "00:06:15,340",
        "to": "00:06:18,640"
      },
      "offsets": {
        "from": 375340,
        "to": 378640
      },
      "text": "中国大妈们在无人超市中休息"
    },
    {
      "timestamps": {
        "from": "00:06:18,640",
        "to": "00:06:22,680"
      },
      "offsets": {
        "from": 378640,
        "to": 382680
      },
      "text": "导致入不敷出超市关门"
    },
    {
      "timestamps": {
        "from": "00:06:23,252",
        "to": "00:06:26,972"
      },
      "offsets": {
        "from": 383252,
        "to": 386972
      },
      "text": "然后特斯拉搞了物联网和无人驾驶"
    },
    {
      "timestamps": {
        "from": "00:06:26,972",
        "to": "00:06:29,572"
      },
      "offsets": {
        "from": 386972,
        "to": 389572
      },
      "text": "最近马云又讲了新的故事"
    },
    {
      "timestamps": {
        "from": "00:06:29,572",
        "to": "00:06:31,372"
      },
      "offsets": {
        "from": 389572,
        "to": 391372
      },
      "text": "新零售网红经济"
    },
    {
      "timestamps": {
        "from": "00:06:31,372",
        "to": "00:06:35,692"
      },
      "offsets": {
        "from": 391372,
        "to": 395692
      },
      "text": "一听都能够改变人类的未来"
    },
    {
      "timestamps": {
        "from": "00:06:35,692",
        "to": "00:06:39,552"
      },
      "offsets": {
        "from": 395692,
        "to": 399552
      },
      "text": "甚至对人类未来的发展会有重大的影响"
    },
    {
      "timestamps": {
        "from": "00:06:39,552",
        "to": "00:06:42,592"
      },
      "offsets": {
        "from": 399552,
        "to": 402592
      },
      "text": "这样的批指当然一下就上去了"
    },
    {
      "timestamps": {
        "from": "00:06:42,592",
        "to": "00:06:47,512"
      },
      "offsets": {
        "from": 402592,
        "to": 407512
      },
      "text": "包括我们也最近知道阿里巴巴股价也刚刚涨破4000亿美金"
    },
    {
      "timestamps": {
        "from": "00:06:47,512",
        "to": "00:06:52,012"
      },
      "offsets": {
        "from": 407512,
        "to": 412012
      },
      "text": "可能据爸爸刚刚2015年上手2000亿"
    },
    {
      "timestamps": {
        "from": "00:06:52,012",
        "to": "00:06:54,632"
      },
      "offsets": {
        "from": 412012,
        "to": 414632
      },
      "text": "也仅仅过去了两年时间"
    },
    {
      "timestamps": {
        "from": "00:06:54,632",
        "to": "00:06:56,252"
      },
      "offsets": {
        "from": 414632,
        "to": 416252
      },
      "text": "阿里巴巴又翻了一倍"
    },
    {
      "timestamps": {
        "from": "00:06:56,252",
        "to": "00:06:57,452"
      },
      "offsets": {
        "from": 416252,
        "to": 417452
      },
      "text": "前一段时间"
    },
    {
      "timestamps": {
        "from": "00:06:57,452",
        "to": "00:07:00,352"
      },
      "offsets": {
        "from": 417452,
        "to": 420352
      },
      "text": "李彦宏开着百度的无人驾驶车"
    },
    {
      "timestamps": {
        "from": "00:07:00,352",
        "to": "00:07:01,312"
      },
      "offsets": {
        "from": 420352,
        "to": 421312
      },
      "text": "上了五环路"
    },
    {
      "timestamps": {
        "from": "00:07:01,312",
        "to": "00:07:03,532"
      },
      "offsets": {
        "from": 421312,
        "to": 423532
      },
      "text": "刚刚装逼就被雷劈"
    },
    {
      "timestamps": {
        "from": "00:07:03,532",
        "to": "00:07:07,452"
      },
      "offsets": {
        "from": 423532,
        "to": 427452
      },
      "text": "交管局立刻发表声明"
    },
    {
      "timestamps": {
        "from": "00:07:07,452",
        "to": "00:07:08,532"
      },
      "offsets": {
        "from": 427452,
        "to": 428532
      },
      "text": "说调查李彦宏"
    },
    {
      "timestamps": {
        "from": "00:07:08,532",
        "to": "00:07:11,912"
      },
      "offsets": {
        "from": 428532,
        "to": 431912
      },
      "text": "因为坐无人驾驶车上马路"
    },
    {
      "timestamps": {
        "from": "00:07:11,912",
        "to": "00:07:13,552"
      },
      "offsets": {
        "from": 431912,
        "to": 433552
      },
      "text": "是违法行为"
    },
    {
      "timestamps": {
        "from": "00:07:13,552",
        "to": "00:07:15,092"
      },
      "offsets": {
        "from": 433552,
        "to": 435092
      },
      "text": "但是实际上"
    },
    {
      "timestamps": {
        "from": "00:07:15,092",
        "to": "00:07:17,792"
      },
      "offsets": {
        "from": 435092,
        "to": 437792
      },
      "text": "我当时在分享这个帖子的时候"
    },
    {
      "timestamps": {
        "from": "00:07:17,792",
        "to": "00:07:18,372"
      },
      "offsets": {
        "from": 437792,
        "to": 438372
      },
      "text": "我就说"
    },
    {
      "timestamps": {
        "from": "00:07:18,372",
        "to": "00:07:19,752"
      },
      "offsets": {
        "from": 438372,
        "to": 439752
      },
      "text": "李彦宏干的好"
    },
    {
      "timestamps": {
        "from": "00:07:19,752",
        "to": "00:07:22,992"
      },
      "offsets": {
        "from": 439752,
        "to": 442992
      },
      "text": "如果一个创新的公司"
    },
    {
      "timestamps": {
        "from": "00:07:22,992",
        "to": "00:07:24,112"
      },
      "offsets": {
        "from": 442992,
        "to": 444112
      },
      "text": "一个创业的公司"
    },
    {
      "timestamps": {
        "from": "00:07:24,112",
        "to": "00:07:26,672"
      },
      "offsets": {
        "from": 444112,
        "to": 446672
      },
      "text": "干的事情如果都没有违法"
    },
    {
      "timestamps": {
        "from": "00:07:26,672",
        "to": "00:07:30,232"
      },
      "offsets": {
        "from": 446672,
        "to": 450232
      },
      "text": "如果你做的事情连法都没有违"
    },
    {
      "timestamps": {
        "from": "00:07:30,232",
        "to": "00:07:32,492"
      },
      "offsets": {
        "from": 450232,
        "to": 452492
      },
      "text": "你怎么有资格说你做了新东西呢"
    },
    {
      "timestamps": {
        "from": "00:07:32,492",
        "to": "00:07:33,872"
      },
      "offsets": {
        "from": 452492,
        "to": 453872
      },
      "text": "换句话说"
    },
    {
      "timestamps": {
        "from": "00:07:33,872",
        "to": "00:07:35,052"
      },
      "offsets": {
        "from": 453872,
        "to": 455052
      },
      "text": "如果你做的领域"
    },
    {
      "timestamps": {
        "from": "00:07:35,052",
        "to": "00:07:37,352"
      },
      "offsets": {
        "from": 455052,
        "to": 457352
      },
      "text": "根本就不是一个打破旧规则的事情"
    },
    {
      "timestamps": {
        "from": "00:07:37,352",
        "to": "00:07:39,872"
      },
      "offsets": {
        "from": 457352,
        "to": 459872
      },
      "text": "或者没有进入一个法律法规"
    },
    {
      "timestamps": {
        "from": "00:07:39,872",
        "to": "00:07:41,312"
      },
      "offsets": {
        "from": 459872,
        "to": 461312
      },
      "text": "都没有覆盖的领域"
    },
    {
      "timestamps": {
        "from": "00:07:41,312",
        "to": "00:07:45,732"
      },
      "offsets": {
        "from": 461312,
        "to": 465732
      },
      "text": "又怎么可能获得超额的利润与回报呢"
    },
    {
      "timestamps": {
        "from": "00:07:46,863",
        "to": "00:07:50,463"
      },
      "offsets": {
        "from": 466863,
        "to": 470463
      },
      "text": "当然我们这个节目当然不是鼓励大家去做违法行为"
    },
    {
      "timestamps": {
        "from": "00:07:50,463",
        "to": "00:07:52,643"
      },
      "offsets": {
        "from": 470463,
        "to": 472643
      },
      "text": "经常有一个句话说的好"
    },
    {
      "timestamps": {
        "from": "00:07:52,643",
        "to": "00:07:57,003"
      },
      "offsets": {
        "from": 472643,
        "to": 477003
      },
      "text": "真正赚钱的事情都已经写进了中华人民共和国的刑法"
    },
    {
      "timestamps": {
        "from": "00:07:57,003",
        "to": "00:08:02,563"
      },
      "offsets": {
        "from": 477003,
        "to": 482563
      },
      "text": "而是鼓励大家要有一种打破规则"
    },
    {
      "timestamps": {
        "from": "00:08:02,563",
        "to": "00:08:05,763"
      },
      "offsets": {
        "from": 482563,
        "to": 485763
      },
      "text": "塑造行业规则的勇气和决心"
    },
    {
      "timestamps": {
        "from": "00:08:05,763",
        "to": "00:08:07,943"
      },
      "offsets": {
        "from": 485763,
        "to": 487943
      },
      "text": "包括加入我们这个创"
    },
    {
      "timestamps": {
        "from": "00:08:07,943",
        "to": "00:08:10,543"
      },
      "offsets": {
        "from": 487943,
        "to": 490543
      },
      "text": "波场这个公司加入陪我APP"
    },
    {
      "timestamps": {
        "from": "00:08:10,543",
        "to": "00:08:14,103"
      },
      "offsets": {
        "from": 490543,
        "to": 494103
      },
      "text": "我们也是鼓励大家去重塑行业规则"
    },
    {
      "timestamps": {
        "from": "00:08:14,263",
        "to": "00:08:16,763"
      },
      "offsets": {
        "from": 494263,
        "to": 496763
      },
      "text": "去产生一些新的想法"
    },
    {
      "timestamps": {
        "from": "00:08:16,763",
        "to": "00:08:18,283"
      },
      "offsets": {
        "from": 496763,
        "to": 498283
      },
      "text": "去向新的领域进军"
    },
    {
      "timestamps": {
        "from": "00:08:18,283",
        "to": "00:08:19,283"
      },
      "offsets": {
        "from": 498283,
        "to": 499283
      },
      "text": "这也是为什么"
    },
    {
      "timestamps": {
        "from": "00:08:19,283",
        "to": "00:08:21,643"
      },
      "offsets": {
        "from": 499283,
        "to": 501643
      },
      "text": "我们这个波场这个公司"
    },
    {
      "timestamps": {
        "from": "00:08:21,643",
        "to": "00:08:23,043"
      },
      "offsets": {
        "from": 501643,
        "to": 503043
      },
      "text": "是从事的虚拟货币"
    },
    {
      "timestamps": {
        "from": "00:08:23,043",
        "to": "00:08:25,563"
      },
      "offsets": {
        "from": 503043,
        "to": 505563
      },
      "text": "比特币数字货币这个领域"
    },
    {
      "timestamps": {
        "from": "00:08:25,563",
        "to": "00:08:26,703"
      },
      "offsets": {
        "from": 505563,
        "to": 506703
      },
      "text": "因为我们觉得"
    },
    {
      "timestamps": {
        "from": "00:08:26,703",
        "to": "00:08:28,823"
      },
      "offsets": {
        "from": 506703,
        "to": 508823
      },
      "text": "这个是真正改变人类未来"
    },
    {
      "timestamps": {
        "from": "00:08:28,823",
        "to": "00:08:30,143"
      },
      "offsets": {
        "from": 508823,
        "to": 510143
      },
      "text": "真正塑造规则"
    },
    {
      "timestamps": {
        "from": "00:08:30,143",
        "to": "00:08:33,603"
      },
      "offsets": {
        "from": 510143,
        "to": 513603
      },
      "text": "真正是一片星辰大海的领域"
    },
    {
      "timestamps": {
        "from": "00:08:33,603",
        "to": "00:08:34,583"
      },
      "offsets": {
        "from": 513603,
        "to": 514583
      },
      "text": "所以这也是为什么"
    },
    {
      "timestamps": {
        "from": "00:08:34,583",
        "to": "00:08:36,123"
      },
      "offsets": {
        "from": 514583,
        "to": 516123
      },
      "text": "我们觉得选择的行业"
    },
    {
      "timestamps": {
        "from": "00:08:36,123",
        "to": "00:08:38,103"
      },
      "offsets": {
        "from": 516123,
        "to": 518103
      },
      "text": "比任何事情都要重要"
    },
    {
      "timestamps": {
        "from": "00:08:38,103",
        "to": "00:08:40,803"
      },
      "offsets": {
        "from": 518103,
        "to": 520803
      },
      "text": "经常我在网上看到有人提问"
    },
    {
      "timestamps": {
        "from": "00:08:40,803",
        "to": "00:08:43,023"
      },
      "offsets": {
        "from": 520803,
        "to": 523023
      },
      "text": "说同学毕业五年后"
    },
    {
      "timestamps": {
        "from": "00:08:43,023",
        "to": "00:08:43,623"
      },
      "offsets": {
        "from": 523023,
        "to": 523623
      },
      "text": "十年后"
    },
    {
      "timestamps": {
        "from": "00:08:43,623",
        "to": "00:08:45,783"
      },
      "offsets": {
        "from": 523623,
        "to": 525783
      },
      "text": "差距为什么那么大呢"
    },
    {
      "timestamps": {
        "from": "00:08:45,783",
        "to": "00:08:47,043"
      },
      "offsets": {
        "from": 525783,
        "to": 527043
      },
      "text": "有的人"
    },
    {
      "timestamps": {
        "from": "00:08:47,409",
        "to": "00:08:48,889"
      },
      "offsets": {
        "from": 527409,
        "to": 528889
      },
      "text": "混得风生水起"
    },
    {
      "timestamps": {
        "from": "00:08:48,889",
        "to": "00:08:51,589"
      },
      "offsets": {
        "from": 528889,
        "to": 531589
      },
      "text": "而我为什么却不给力呢"
    },
    {
      "timestamps": {
        "from": "00:08:51,589",
        "to": "00:08:54,029"
      },
      "offsets": {
        "from": 531589,
        "to": 534029
      },
      "text": "原因也很简单"
    },
    {
      "timestamps": {
        "from": "00:08:54,029",
        "to": "00:08:56,449"
      },
      "offsets": {
        "from": 534029,
        "to": 536449
      },
      "text": "就像我们刚才讲的财富曲线"
    },
    {
      "timestamps": {
        "from": "00:08:56,449",
        "to": "00:09:00,809"
      },
      "offsets": {
        "from": 536449,
        "to": 540809
      },
      "text": "有的人毕业进了规则已经既定好的领域"
    },
    {
      "timestamps": {
        "from": "00:09:00,809",
        "to": "00:09:03,529"
      },
      "offsets": {
        "from": 540809,
        "to": 543529
      },
      "text": "那么你就顺着这条线慢慢爬"
    },
    {
      "timestamps": {
        "from": "00:09:03,529",
        "to": "00:09:06,529"
      },
      "offsets": {
        "from": 543529,
        "to": 546529
      },
      "text": "看起来是很稳定的"
    },
    {
      "timestamps": {
        "from": "00:09:06,529",
        "to": "00:09:08,909"
      },
      "offsets": {
        "from": 546529,
        "to": 548909
      },
      "text": "但却冒最大的风险"
    },
    {
      "timestamps": {
        "from": "00:09:08,909",
        "to": "00:09:12,229"
      },
      "offsets": {
        "from": 548909,
        "to": 552229
      },
      "text": "因为你的未来早已被锁定"
    },
    {
      "timestamps": {
        "from": "00:09:12,229",
        "to": "00:09:15,109"
      },
      "offsets": {
        "from": 552229,
        "to": 555109
      },
      "text": "就像我刚才讲的传统行业一样"
    },
    {
      "timestamps": {
        "from": "00:09:15,109",
        "to": "00:09:17,649"
      },
      "offsets": {
        "from": 555109,
        "to": 557649
      },
      "text": "未来一条路看到黑"
    },
    {
      "timestamps": {
        "from": "00:09:17,649",
        "to": "00:09:20,109"
      },
      "offsets": {
        "from": 557649,
        "to": 560109
      },
      "text": "感觉没有任何的增长的空间"
    },
    {
      "timestamps": {
        "from": "00:09:20,109",
        "to": "00:09:22,269"
      },
      "offsets": {
        "from": 560109,
        "to": 562269
      },
      "text": "而不让规则走的人"
    },
    {
      "timestamps": {
        "from": "00:09:22,269",
        "to": "00:09:24,229"
      },
      "offsets": {
        "from": 562269,
        "to": 564229
      },
      "text": "可能一开始承担了一些风险"
    },
    {
      "timestamps": {
        "from": "00:09:24,229",
        "to": "00:09:27,889"
      },
      "offsets": {
        "from": 564229,
        "to": 567889
      },
      "text": "但是它是一条指数性上涨的曲线"
    },
    {
      "timestamps": {
        "from": "00:09:27,889",
        "to": "00:09:29,849"
      },
      "offsets": {
        "from": 567889,
        "to": 569849
      },
      "text": "一旦干成了"
    },
    {
      "timestamps": {
        "from": "00:09:29,849",
        "to": "00:09:31,789"
      },
      "offsets": {
        "from": 569849,
        "to": 571789
      },
      "text": "马上就起来了"
    }
  ]
}
