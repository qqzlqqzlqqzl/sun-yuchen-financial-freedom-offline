        "from": "00:03:23,470",
        "to": "00:03:26,850"
      },
      "offsets": {
        "from": 203470,
        "to": 206850
      },
      "text": "用生命意志对抗人生虚无"
    },
    {
      "timestamps": {
        "from": "00:03:26,850",
        "to": "00:03:27,950"
      },
      "offsets": {
        "from": 206850,
        "to": 207950
      },
      "text": "其实想想"
    },
    {
      "timestamps": {
        "from": "00:03:27,950",
        "to": "00:03:29,910"
      },
      "offsets": {
        "from": 207950,
        "to": 209910
      },
      "text": "如果张锐早点听到我们这个课"
    },
    {
      "timestamps": {
        "from": "00:03:29,910",
        "to": "00:03:30,910"
      },
      "offsets": {
        "from": 209910,
        "to": 210910
      },
      "text": "当然我们这课"
    },
    {
      "timestamps": {
        "from": "00:03:30,910",
        "to": "00:03:32,310"
      },
      "offsets": {
        "from": 210910,
        "to": 212310
      },
      "text": "现在开的可能有点晚了"
    },
    {
      "timestamps": {
        "from": "00:03:32,310",
        "to": "00:03:33,930"
      },
      "offsets": {
        "from": 212310,
        "to": 213930
      },
      "text": "大家今天能听到"
    },
    {
      "timestamps": {
        "from": "00:03:33,930",
        "to": "00:03:34,770"
      },
      "offsets": {
        "from": 213930,
        "to": 214770
      },
      "text": "当然很幸运"
    },
    {
      "timestamps": {
        "from": "00:03:34,770",
        "to": "00:03:37,170"
      },
      "offsets": {
        "from": 214770,
        "to": 217170
      },
      "text": "如果他能多做几次体检"
    },
    {
      "timestamps": {
        "from": "00:03:37,170",
        "to": "00:03:38,170"
      },
      "offsets": {
        "from": 217170,
        "to": 218170
      },
      "text": "然后呢"
    },
    {
      "timestamps": {
        "from": "00:03:38,170",
        "to": "00:03:40,210"
      },
      "offsets": {
        "from": 218170,
        "to": 220210
      },
      "text": "医生发现了他的"
    },
    {
      "timestamps": {
        "from": "00:03:40,210",
        "to": "00:03:41,970"
      },
      "offsets": {
        "from": 220210,
        "to": 221970
      },
      "text": "这个心肌梗塞的问题"
    },
    {
      "timestamps": {
        "from": "00:03:41,970",
        "to": "00:03:43,430"
      },
      "offsets": {
        "from": 221970,
        "to": 223430
      },
      "text": "包括发现他心血管疾病"
    },
    {
      "timestamps": {
        "from": "00:03:43,430",
        "to": "00:03:43,910"
      },
      "offsets": {
        "from": 223430,
        "to": 223910
      },
      "text": "都会"
    },
    {
      "timestamps": {
        "from": "00:03:43,996",
        "to": "00:03:46,976"
      },
      "offsets": {
        "from": 223996,
        "to": 226976
      },
      "text": "提醒他平时多注意的时候"
    },
    {
      "timestamps": {
        "from": "00:03:46,976",
        "to": "00:03:51,836"
      },
      "offsets": {
        "from": 226976,
        "to": 231836
      },
      "text": "将医生的建议尽可能的排到比较高的优先级"
    },
    {
      "timestamps": {
        "from": "00:03:51,836",
        "to": "00:03:53,576"
      },
      "offsets": {
        "from": 231836,
        "to": 233576
      },
      "text": "去采纳的话"
    },
    {
      "timestamps": {
        "from": "00:03:53,576",
        "to": "00:03:57,016"
      },
      "offsets": {
        "from": 233576,
        "to": 237016
      },
      "text": "我相信这个悲剧就不会发生"
    },
    {
      "timestamps": {
        "from": "00:03:57,016",
        "to": "00:03:59,716"
      },
      "offsets": {
        "from": 237016,
        "to": 239716
      },
      "text": "因为即便像心肌梗塞这种疾病"
    },
    {
      "timestamps": {
        "from": "00:03:59,716",
        "to": "00:04:02,276"
      },
      "offsets": {
        "from": 239716,
        "to": 242276
      },
      "text": "也并不是说一发作就会死人的"
    },
    {
      "timestamps": {
        "from": "00:04:02,276",
        "to": "00:04:06,616"
      },
      "offsets": {
        "from": 242276,
        "to": 246616
      },
      "text": "某种程度上只要旁边的人救援得到"
    },
    {
      "timestamps": {
        "from": "00:04:06,616",
        "to": "00:04:08,976"
      },
      "offsets": {
        "from": 246616,
        "to": 248976
      },
      "text": "能够尽早服药"
    },
    {
      "timestamps": {
        "from": "00:04:08,976",
        "to": "00:04:11,596"
      },
      "offsets": {
        "from": 248976,
        "to": 251596
      },
      "text": "有心肺复苏这一类的抢救"
    },
    {
      "timestamps": {
        "from": "00:04:11,596",
        "to": "00:04:14,456"
      },
      "offsets": {
        "from": 251596,
        "to": 254456
      },
      "text": "很大概率上还是能抢救过来的"
    },
    {
      "timestamps": {
        "from": "00:04:14,456",
        "to": "00:04:17,276"
      },
      "offsets": {
        "from": 254456,
        "to": 257276
      },
      "text": "但是这都必须建立在"
    },
    {
      "timestamps": {
        "from": "00:04:17,276",
        "to": "00:04:19,096"
      },
      "offsets": {
        "from": 257276,
        "to": 259096
      },
      "text": "你把医生的所有事情都"
    },
    {
      "timestamps": {
        "from": "00:04:19,096",
        "to": "00:04:21,436"
      },
      "offsets": {
        "from": 259096,
        "to": 261436
      },
      "text": "非常认真take seriously"
    },
    {
      "timestamps": {
        "from": "00:04:21,436",
        "to": "00:04:23,956"
      },
      "offsets": {
        "from": 261436,
        "to": 263956
      },
      "text": "同时平常的生活习惯"
    },
    {
      "timestamps": {
        "from": "00:04:23,956",
        "to": "00:04:25,516"
      },
      "offsets": {
        "from": 263956,
        "to": 265516
      },
      "text": "以及生活措施"
    },
    {
      "timestamps": {
        "from": "00:04:25,516",
        "to": "00:04:29,976"
      },
      "offsets": {
        "from": 265516,
        "to": 269976
      },
      "text": "都是非常注意的基础上才能避免"
    },
    {
      "timestamps": {
        "from": "00:04:29,976",
        "to": "00:04:32,936"
      },
      "offsets": {
        "from": 269976,
        "to": 272936
      },
      "text": "基本上对于这种心机梗塞的人"
    },
    {
      "timestamps": {
        "from": "00:04:32,936",
        "to": "00:04:35,436"
      },
      "offsets": {
        "from": 272936,
        "to": 275436
      },
      "text": "我们一般希望他七成二十四小时"
    },
    {
      "timestamps": {
        "from": "00:04:35,436",
        "to": "00:04:37,396"
      },
      "offsets": {
        "from": 275436,
        "to": 277396
      },
      "text": "身边都要有人照顾他"
    },
    {
      "timestamps": {
        "from": "00:04:37,396",
        "to": "00:04:41,276"
      },
      "offsets": {
        "from": 277396,
        "to": 281276
      },
      "text": "当年我的偶像王小波"
    },
    {
      "timestamps": {
        "from": "00:04:41,276",
        "to": "00:04:43,676"
      },
      "offsets": {
        "from": 281276,
        "to": 283676
      },
      "text": "他也是因为三更半夜的时候"
    },
    {
      "timestamps": {
        "from": "00:04:43,676",
        "to": "00:04:45,176"
      },
      "offsets": {
        "from": 283676,
        "to": 285176
      },
      "text": "心脏病发"
    },
    {
      "timestamps": {
        "from": "00:04:45,176",
        "to": "00:04:49,596"
      },
      "offsets": {
        "from": 285176,
        "to": 289596
      },
      "text": "但是他老婆李英和还在国外参加学术会议"
    },
    {
      "timestamps": {
        "from": "00:04:49,596",
        "to": "00:04:50,816"
      },
      "offsets": {
        "from": 289596,
        "to": 290816
      },
      "text": "所以王小波呢"
    },
    {
      "timestamps": {
        "from": "00:04:50,816",
        "to": "00:04:52,416"
      },
      "offsets": {
        "from": 290816,
        "to": 292416
      },
      "text": "也没有得到非常好的照顾"
    },
    {
      "timestamps": {
        "from": "00:04:52,416",
        "to": "00:04:55,416"
      },
      "offsets": {
        "from": 292416,
        "to": 295416
      },
      "text": "结果也就很早就离开了我们"
    },
    {
      "timestamps": {
        "from": "00:04:55,416",
        "to": "00:04:59,336"
      },
      "offsets": {
        "from": 295416,
        "to": 299336
      },
      "text": "所以在这种活生生的案例面前啊"
    },
    {
      "timestamps": {
        "from": "00:04:58,832",
        "to": "00:05:02,112"
      },
      "offsets": {
        "from": 298832,
        "to": 302112
      },
      "text": "甚至我们觉得财富都已经不再重要"
    },
    {
      "timestamps": {
        "from": "00:05:02,112",
        "to": "00:05:04,832"
      },
      "offsets": {
        "from": 302112,
        "to": 304832
      },
      "text": "确实是生命是非常重要的"
    },
    {
      "timestamps": {
        "from": "00:05:04,832",
        "to": "00:05:07,292"
      },
      "offsets": {
        "from": 304832,
        "to": 307292
      },
      "text": "所以财富自由的防御"
    },
    {
      "timestamps": {
        "from": "00:05:07,292",
        "to": "00:05:10,092"
      },
      "offsets": {
        "from": 307292,
        "to": 310092
      },
      "text": "第一条我们就要讲医疗"
    },
    {
      "timestamps": {
        "from": "00:05:10,092",
        "to": "00:05:14,292"
      },
      "offsets": {
        "from": 310092,
        "to": 314292
      },
      "text": "这一条真的是对财富自由的重要性和必要性"
    },
    {
      "timestamps": {
        "from": "00:05:14,292",
        "to": "00:05:17,472"
      },
      "offsets": {
        "from": 314292,
        "to": 317472
      },
      "text": "不能再过多的强调了"
    },
    {
      "timestamps": {
        "from": "00:05:17,472",
        "to": "00:05:20,652"
      },
      "offsets": {
        "from": 317472,
        "to": 320652
      },
      "text": "其实除了医疗问题之外"
    },
    {
      "timestamps": {
        "from": "00:05:20,652",
        "to": "00:05:25,052"
      },
      "offsets": {
        "from": 320652,
        "to": 325052
      },
      "text": "对人总体财富还有一个比较大的打击"
    },
    {
      "timestamps": {
        "from": "00:05:25,052",
        "to": "00:05:26,332"
      },
      "offsets": {
        "from": 325052,
        "to": 326332
      },
      "text": "尤其是中产阶级"
    },
    {
      "timestamps": {
        "from": "00:05:26,332",
        "to": "00:05:29,672"
      },
      "offsets": {
        "from": 326332,
        "to": 329672
      },
      "text": "就是家人关系的处理问题"
    },
    {
      "timestamps": {
        "from": "00:05:29,672",
        "to": "00:05:31,452"
      },
      "offsets": {
        "from": 329672,
        "to": 331452
      },
      "text": "这一点呢"
    },
    {
      "timestamps": {
        "from": "00:05:31,452",
        "to": "00:05:33,252"
      },
      "offsets": {
        "from": 331452,
        "to": 333252
      },
      "text": "其实绝大多数人呢"
    },
    {
      "timestamps": {
        "from": "00:05:33,252",
        "to": "00:05:35,112"
      },
      "offsets": {
        "from": 333252,
        "to": 335112
      },
      "text": "可能并没有意识"
    },
    {
      "timestamps": {
        "from": "00:05:35,112",
        "to": "00:05:38,992"
      },
      "offsets": {
        "from": 335112,
        "to": 338992
      },
      "text": "就跟我们平常日常生活中"
    },
    {
      "timestamps": {
        "from": "00:05:38,992",
        "to": "00:05:41,812"
      },
      "offsets": {
        "from": 338992,
        "to": 341812
      },
      "text": "绝大多数的文学刊物啊"
    },
    {
      "timestamps": {
        "from": "00:05:41,812",
        "to": "00:05:43,112"
      },
      "offsets": {
        "from": 341812,
        "to": 343112
      },
      "text": "绝大多数故事"
    },
    {
      "timestamps": {
        "from": "00:05:43,112",
        "to": "00:05:44,832"
      },
      "offsets": {
        "from": 343112,
        "to": 344832
      },
      "text": "包括绝大多数广告"
    },
    {
      "timestamps": {
        "from": "00:05:44,832",
        "to": "00:05:46,592"
      },
      "offsets": {
        "from": 344832,
        "to": 346592
      },
      "text": "都给我们的是一种"
    },
    {
      "timestamps": {
        "from": "00:05:46,592",
        "to": "00:05:50,272"
      },
      "offsets": {
        "from": 346592,
        "to": 350272
      },
      "text": "家庭朋友亲戚"
    },
    {
      "timestamps": {
        "from": "00:05:50,272",
        "to": "00:05:54,132"
      },
      "offsets": {
        "from": 350272,
        "to": 354132
      },
      "text": "日常非常祥和的这么一个景象"
    },
    {
      "timestamps": {
        "from": "00:05:54,132",
        "to": "00:05:55,812"
      },
      "offsets": {
        "from": 354132,
        "to": 355812
      },
      "text": "不知道大家有没有看过"
    },
    {
      "timestamps": {
        "from": "00:05:55,812",
        "to": "00:05:58,072"
      },
      "offsets": {
        "from": 355812,
        "to": 358072
      },
      "text": "什么类似于这种旺旺啊"
    },
    {
      "timestamps": {
        "from": "00:05:58,072",
        "to": "00:05:59,492"
      },
      "offsets": {
        "from": 358072,
        "to": 359492
      },
      "text": "什么这些企业的广告是吧"
    },
    {
      "timestamps": {
        "from": "00:05:59,492",
        "to": "00:06:01,152"
      },
      "offsets": {
        "from": 359492,
        "to": 361152
      },
      "text": "都是爷爷奶奶抱一圈"
    },
    {
      "timestamps": {
        "from": "00:06:01,152",
        "to": "00:06:02,992"
      },
      "offsets": {
        "from": 361152,
        "to": 362992
      },
      "text": "大家都笑开花对吧"
    },
    {
      "timestamps": {
        "from": "00:06:02,992",
        "to": "00:06:04,632"
      },
      "offsets": {
        "from": 362992,
        "to": 364632
      },
      "text": "中国人比较喜欢"
    },
    {
      "timestamps": {
        "from": "00:06:04,632",
        "to": "00:06:06,412"
      },
      "offsets": {
        "from": 364632,
        "to": 366412
      },
      "text": "就宣扬中家庭的这个"
    },
    {
      "timestamps": {
        "from": "00:06:06,412",
        "to": "00:06:08,752"
      },
      "offsets": {
        "from": 366412,
        "to": 368752
      },
      "text": "朋友家庭之间的"
    },
    {
      "timestamps": {
        "from": "00:06:08,752",
        "to": "00:06:10,652"
      },
      "offsets": {
        "from": 368752,
        "to": 370652
      },
      "text": "非常和谐洋溢的气氛"
    },
    {
      "timestamps": {
        "from": "00:06:10,652",
        "to": "00:06:13,672"
      },
      "offsets": {
        "from": 370652,
        "to": 373672
      },
      "text": "但某种程度上事实"
    },
    {
      "timestamps": {
        "from": "00:06:14,220",
        "to": "00:06:15,180"
      },
      "offsets": {
        "from": 374220,
        "to": 375180
      },
      "text": "并不是这样"
    },
    {
      "timestamps": {
        "from": "00:06:15,180",
        "to": "00:06:18,900"
      },
      "offsets": {
        "from": 375180,
        "to": 378900
      },
      "text": "举一个大家也比较了解的例子"
    },
    {
      "timestamps": {
        "from": "00:06:18,900",
        "to": "00:06:22,360"
      },
      "offsets": {
        "from": 378900,
        "to": 382360
      },
      "text": "就是一种刑事犯罪叫强奸"
    },
    {
      "timestamps": {
        "from": "00:06:22,360",
        "to": "00:06:25,480"
      },
      "offsets": {
        "from": 382360,
        "to": 385480
      },
      "text": "在人们传统意识中"
    },
    {
      "timestamps": {
        "from": "00:06:25,480",
        "to": "00:06:30,760"
      },
      "offsets": {
        "from": 385480,
        "to": 390760
      },
      "text": "强奸案都是发生在这种越黑风高的荒郊野岭"
    },
    {
      "timestamps": {
        "from": "00:06:30,760",
        "to": "00:06:34,120"
      },
      "offsets": {
        "from": 390760,
        "to": 394120
      },
      "text": "然后一个女子不知道为什么脑子抽了"
    },
    {
      "timestamps": {
        "from": "00:06:34,120",
        "to": "00:06:36,040"
      },
      "offsets": {
        "from": 394120,
        "to": 396040
      },
      "text": "走在这个荒郊野岭上"
    },
    {
      "timestamps": {
        "from": "00:06:36,040",
        "to": "00:06:41,640"
      },
      "offsets": {
        "from": 396040,
        "to": 401640
      },
      "text": "然后一个陌生的黑大汉突然从草丛中冲出"
    },
    {
      "timestamps": {
        "from": "00:06:41,640",
        "to": "00:06:44,860"
      },
      "offsets": {
        "from": 401640,
        "to": 404860
      },
      "text": "用凶器威胁受害人将其强奸了"
    },
    {
      "timestamps": {
        "from": "00:06:44,860",
        "to": "00:06:47,120"
      },
      "offsets": {
        "from": 404860,
        "to": 407120
      },
      "text": "这是大家包括我自己"
    },
    {
